# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/goacme/lego:v5.6.0@sha256:6f1583fc026a455ea46a7a5858c576105bb69c2e2de69db391cab7f14750350c
ContainerName=acme
LogDriver=journald
ReadOnly=true
DropCapability=ALL
AddCapability=CHOWN
NoNewPrivileges=true
Network=net-acme-egress.network
Volume=/opt/basetool/docker/acme:/etc/acme:ro
Volume=edge-acme-state.volume:/data
Volume=edge-acme-webroot.volume:/webroot
Volume=edge-certs.volume:/certs
EnvironmentFile=/etc/basetool/env.d/acme.env
Entrypoint=/bin/sh
Exec=/etc/acme/publish-loop.sh
Memory=128M
PidsLimit=128
PodmanArgs=--cpus=0.5

[Service]
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
