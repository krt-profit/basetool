[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/goacme/lego:v5.5.1@sha256:9c446e8ce05155f87475ce87392a5c55472a7ecd06e244752f762d2f4b162e8d
ContainerName=acme
LogDriver=journald
ReadOnly=true
DropCapability=ALL
AddCapability=CHOWN
NoNewPrivileges=true
Network=net-acme-egress.network
Volume=/var/iri/code/docker/acme:/etc/acme:ro
Volume=edge-acme-state.volume:/data
Volume=edge-acme-webroot.volume:/webroot
Volume=edge-certs.volume:/certs
EnvironmentFile=/var/iri/code/env.d/acme.env
Entrypoint=/bin/sh
Exec=/etc/acme/publish-loop.sh
Memory=128M
PidsLimit=128
PodmanArgs=--cpus=0.5

[Service]
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
