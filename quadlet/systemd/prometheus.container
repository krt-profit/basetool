# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/prom/prometheus:v3.14.0@sha256:5ce7540c3c00ef4ab0c9d2c995c6a5b9c421f44b4a115d97a2c7af3b1c21cbb0
ContainerName=prometheus
DropCapability=ALL
NoNewPrivileges=true
Network=net-monitoring-core.network
Network=net-monitoring-scrape.network
Volume=/var/iri/code/monitoring/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
Volume=/var/iri/code/monitoring/prometheus/alerts:/etc/prometheus/alerts:ro
Volume=/var/iri/monitoring/secrets/prometheus-web.yml:/etc/prometheus/web.yml:ro
Volume=/var/iri/monitoring/secrets/scrape_password:/etc/prometheus/secrets/scrape_password:ro
Volume=/var/iri/monitoring/secrets/prometheus_web_password:/etc/prometheus/secrets/web_password:ro
Volume=/var/iri/monitoring/certs/basetool-ca.crt:/etc/prometheus/certs/basetool-ca.crt:ro
Volume=/var/iri/monitoring/data/prometheus:/prometheus
EnvironmentFile=/var/iri/code/env.d/prometheus.env
Exec=--config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/prometheus --storage.tsdb.retention.time=180d --storage.tsdb.retention.size=40GB --web.enable-admin-api --web.config.file=/etc/prometheus/web.yml --web.enable-lifecycle --web.enable-remote-write-receiver
Memory=1024M
PidsLimit=512
PodmanArgs=--oom-score-adj=500

[Service]
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
