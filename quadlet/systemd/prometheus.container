# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/prom/prometheus:v3.15.1@sha256:fa3302279710be2f21a8301ec17a8b4f2301fd829bd113839b3b6b02b6f191a2
ContainerName=prometheus
LogDriver=journald
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=net-monitoring-core.network
Network=net-monitoring-scrape.network
Volume=/opt/basetool/monitoring/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
Volume=/opt/basetool/monitoring/prometheus/alerts:/etc/prometheus/alerts:ro
Volume=/etc/basetool/monitoring/secrets/prometheus-web.yml:/etc/prometheus/web.yml:ro
Volume=/etc/basetool/monitoring/secrets/scrape_password:/etc/prometheus/secrets/scrape_password:ro
Volume=/etc/basetool/monitoring/secrets/prometheus_web_password:/etc/prometheus/secrets/web_password:ro
Volume=/etc/basetool/monitoring/certs/basetool-ca.crt:/etc/prometheus/certs/basetool-ca.crt:ro
Volume=/var/lib/basetool/monitoring/prometheus:/prometheus
EnvironmentFile=/etc/basetool/env.d/prometheus.env
Exec=--config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/prometheus --storage.tsdb.retention.time=180d --storage.tsdb.retention.size=40GB --web.enable-admin-api --web.config.file=/etc/prometheus/web.yml --web.enable-remote-write-receiver
Memory=1024M
PidsLimit=512
RunInit=true
AddHost=node-exporter:host-gateway
AddHost=alloy:host-gateway
AddHost=podman-exporter:host-gateway
PodmanArgs=--oom-score-adj=500

[Service]
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
