# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/postgres:18-alpine@sha256:10a5c69a83035ab5239f5620d708520e8b28f5aa1f2b20143e6024532edadfb5
ContainerName=db-backend
LogDriver=journald
User=70
Group=70
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=net-db-backend.network
Volume=/var/lib/basetool/db-backend:/var/lib/postgresql/data
EnvironmentFile=/etc/basetool/env.d/db-backend.env
Exec=postgres -c shared_buffers=384MB -c effective_cache_size=1024MB -c work_mem=8MB -c maintenance_work_mem=64MB -c max_connections=150 -c random_page_cost=1.1 -c max_parallel_workers_per_gather=0 -c jit=off -c shared_preload_libraries=pg_stat_statements -c log_error_verbosity=terse -c log_line_prefix='%%m [%%p] %%q%%u@%%d/%%a '

HealthCmd=pg_isready -U ${POSTGRES_USER:?} -d ${POSTGRES_DB:?} -p 15432
HealthInterval=5s
HealthTimeout=5s
HealthRetries=5
Notify=healthy
Memory=1536M
PidsLimit=512
PodmanArgs=--cpus=4.0
StopTimeout=60

[Service]
TimeoutStartSec=110
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60
TimeoutStopSec=75

[Install]
WantedBy=default.target
