# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Container]
Image=docker.io/postgres:18-alpine@sha256:d3e1620b530c944afa6e887d22eb899824da68e19c52024bf98f5220c88a65b2
ContainerName=db-backend
DropCapability=ALL
AddCapability=CHOWN
AddCapability=DAC_OVERRIDE
AddCapability=FOWNER
AddCapability=SETGID
AddCapability=SETUID
NoNewPrivileges=true
Network=net-db-backend.network
Volume=/var/iri/db-backend:/var/lib/postgresql/data
EnvironmentFile=/var/iri/code/env.d/db-backend.env
Exec=postgres -c shared_buffers=384MB -c effective_cache_size=1024MB -c work_mem=8MB -c maintenance_work_mem=64MB -c max_connections=150 -c random_page_cost=1.1 -c max_parallel_workers_per_gather=0 -c jit=off -c shared_preload_libraries=pg_stat_statements -c log_error_verbosity=terse -c log_line_prefix='%m [%p] %q%u@%d/%a '

HealthCmd=pg_isready -U ${POSTGRES_USER:?} -d ${POSTGRES_DB:?} -p 15432
HealthInterval=5s
HealthTimeout=5s
HealthRetries=5
Notify=healthy
Memory=1536M
PodmanArgs=--cpus=4.0

[Service]
Restart=always
TimeoutStopSec=60

[Install]
WantedBy=default.target
