# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/prom/blackbox-exporter:v0.28.0@sha256:e753ff9f3fc458d02cca5eddab5a77e1c175eee484a8925ac7d524f04366c2fc
ContainerName=blackbox-exporter
LogDriver=journald
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=net-monitoring-core.network
Network=net-monitoring-scrape.network
Network=net-blackbox-v6.network
Volume=/var/iri/code/monitoring/blackbox/blackbox.yml:/etc/blackbox/blackbox.yml:ro
Volume=/var/iri/monitoring/certs/basetool-ca.crt:/etc/blackbox/certs/basetool-ca.crt:ro
EnvironmentFile=/var/iri/code/env.d/blackbox-exporter.env
Exec=--config.file=/etc/blackbox/blackbox.yml
Memory=64M
PidsLimit=512
PodmanArgs=--oom-score-adj=500 --init

[Service]
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
