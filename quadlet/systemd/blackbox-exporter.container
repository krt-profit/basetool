# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/prom/blackbox-exporter:v0.29.1@sha256:ea1c7aa3ef3f307cd03e85f34abb604478ccb90b567fc690da0cd9776da76b13
ContainerName=blackbox-exporter
LogDriver=journald
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=net-monitoring-core.network
Network=net-monitoring-scrape.network
Network=net-blackbox-v6.network
Volume=/opt/basetool/monitoring/blackbox/blackbox.yml:/etc/blackbox/blackbox.yml:ro
Volume=/etc/basetool/monitoring/certs/basetool-ca.crt:/etc/blackbox/certs/basetool-ca.crt:ro
EnvironmentFile=/etc/basetool/env.d/blackbox-exporter.env
Exec=--config.file=/etc/blackbox/blackbox.yml
Memory=64M
PidsLimit=512
RunInit=true
PodmanArgs=--oom-score-adj=500

[Service]
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
