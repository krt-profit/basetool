[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/prom/blackbox-exporter:v0.29.0@sha256:9613f2884689b6fad9f1939f6a3b0388c93a022cfaededb19545b329b5c83dea
ContainerName=blackbox-exporter
LogDriver=journald
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=net-monitoring-core.network
Network=net-monitoring-scrape.network
Network=net-blackbox-v6.network
Volume=/var/iri/code/monitoring/blackbox/blackbox.yml:/etc/blackbox/blackbox.yml:ro
Volume=/var/iri/monitoring/certs/basetool-ca.crt:/etc/blackbox/certs/basetool-ca.crt:ro
EnvironmentFile=/var/iri/code/env.d/blackbox-exporter.env
Exec=--config.file=/etc/blackbox/blackbox.yml
Memory=64M
PidsLimit=512
RunInit=true
PodmanArgs=--oom-score-adj=500

[Service]
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
