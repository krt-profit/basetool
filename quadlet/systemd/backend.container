# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
After=db-backend.service keycloak.service
Requires=db-backend.service keycloak.service
StartLimitIntervalSec=0

[Container]
Image=ghcr.io/krt-profit/basetool-backend:stable
ContainerName=backend
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=net-db-backend.network
Network=net-backend-frontend.network
Network=net-backend-keycloak.network
Network=net-backend-ingest.network
Network=net-proxy-api.network
Network=net-redis-backend.network
Network=net-monitoring-scrape.network
Volume=/var/iri/backend/log:/app/logs
Volume=/var/iri/secrets/keystore.p12:/run/secrets/keystore.p12:ro
Volume=/var/iri/secrets/keystore.p12:/run/secrets/truststore.p12:ro
EnvironmentFile=/var/iri/code/env.d/backend.env
HealthCmd=wget -q --no-check-certificate -O /dev/null https://localhost:11271/actuator/health/readiness
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=90s
HealthStartupInterval=5s
Notify=healthy
Memory=2048M
PidsLimit=2048
AddHost=localhost:127.0.0.1
PodmanArgs=--cpus=3.0 --init --ulimit nofile=65536:65536

[Service]
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60
TimeoutStopSec=30

[Install]
WantedBy=default.target
