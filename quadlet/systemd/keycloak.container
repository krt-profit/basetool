# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
After=db-keycloak.service
Requires=db-keycloak.service
StartLimitIntervalSec=0

[Container]
Image=quay.io/keycloak/keycloak:26.8@sha256:79c623a22abacf3fe6c00a5fb30f5b7843d717b234033b80995891c06116d244
ContainerName=keycloak
LogDriver=journald
ReadOnly=true
DropCapability=ALL
Tmpfs=/opt/keycloak/lib/quarkus:rw,tmpcopyup
Tmpfs=/opt/keycloak/data/transaction-logs:rw
Tmpfs=/opt/keycloak/data/tmp:rw
NoNewPrivileges=true
Network=net-db-keycloak.network
Network=net-proxy-keycloak.network
Network=net-backend-keycloak.network
Network=net-monitoring-scrape.network
Volume=/opt/basetool/keycloak-theme/krt-theme:/opt/keycloak/themes/krt-theme:ro
Volume=/opt/basetool/keycloak/providers:/opt/keycloak/providers:ro
Volume=/var/log/basetool/keycloak:/var/log/keycloak
Volume=/etc/basetool/secrets/tls/keycloak.p12:/run/secrets/keystore.p12:ro
EnvironmentFile=/etc/basetool/env.d/keycloak.env
Exec=start --proxy-headers xforwarded --cache=local --http-enabled=false --https-port=18443 --https-key-store-file=/run/secrets/keystore.p12 --http-management-scheme=http --log=console,file --log-file=/var/log/keycloak/keycloak.log

HealthCmd=exec 3<>/dev/tcp/127.0.0.1/9000 && printf 'GET /health/ready HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' >&3 && grep -q '200 OK' <&3
HealthInterval=10s
HealthTimeout=10s
HealthRetries=15
HealthStartPeriod=30s
Notify=healthy
Memory=2560M
PidsLimit=2048
AddHost=alloy:host-gateway
PodmanArgs=--cpus=3.0
StopTimeout=30

[Service]
TimeoutStartSec=390
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60
TimeoutStopSec=45

[Install]
WantedBy=default.target
