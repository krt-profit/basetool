# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
After=backend.service keycloak.service redis.service
Requires=backend.service keycloak.service redis.service
StartLimitIntervalSec=0

[Container]
Image=ghcr.io/krt-profit/basetool-frontend:stable
ContainerName=frontend
LogDriver=journald
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=net-backend-frontend.network
Network=net-proxy-frontend.network
Network=net-backend-keycloak.network
Network=net-redis-frontend.network
Network=net-monitoring-scrape.network
Volume=/var/iri/frontend/log:/app/logs
Volume=/var/iri/secrets/keystore.p12:/run/secrets/keystore.p12:ro
Volume=/var/iri/secrets/keystore.p12:/run/secrets/truststore.p12:ro
EnvironmentFile=/var/iri/code/env.d/frontend.env
HealthCmd=wget -q --no-check-certificate -O /dev/null https://localhost:18091/actuator/health/readiness
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=90s
HealthStartupInterval=5s
Notify=healthy
Memory=1792M
PidsLimit=2048
AddHost=localhost:127.0.0.1
AddHost=alloy:host-gateway
PodmanArgs=--cpus=2.0 --init --ulimit nofile=65536:65536

[Service]
TimeoutStartSec=255
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60
TimeoutStopSec=30

[Install]
WantedBy=default.target
