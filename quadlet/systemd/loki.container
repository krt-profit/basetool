# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/grafana/loki:3.7.9@sha256:0db216b630ae1f348a1584c67f3cead8b4c1fc839169a39501db664744158e28
ContainerName=loki
LogDriver=journald
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
PublishPort=127.0.0.1:3100:3100
Network=net-monitoring-core.network
Volume=/opt/basetool/monitoring/loki/loki-config.yml:/etc/loki/loki-config.yml:ro
Volume=/opt/basetool/monitoring/loki/rules:/etc/loki/rules:ro
Volume=/var/lib/basetool/monitoring/loki:/loki
EnvironmentFile=/etc/basetool/env.d/loki.env
Exec=-config.file=/etc/loki/loki-config.yml
Memory=384M
PidsLimit=512
RunInit=true
PodmanArgs=--oom-score-adj=500
StopTimeout=45

[Service]
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60
TimeoutStopSec=60

[Install]
WantedBy=default.target
