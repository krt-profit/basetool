# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/grafana/loki:3.7.8@sha256:1107dd5274e0ada47e42472b7a7e71f3b2a2fe878878108f3e2f9e51528f0193
ContainerName=loki
LogDriver=journald
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
PublishPort=127.0.0.1:3100:3100
Network=net-monitoring-core.network
Volume=/var/iri/code/monitoring/loki/loki-config.yml:/etc/loki/loki-config.yml:ro
Volume=/var/iri/code/monitoring/loki/rules:/etc/loki/rules:ro
Volume=/var/iri/monitoring/data/loki:/loki
EnvironmentFile=/var/iri/code/env.d/loki.env
Exec=-config.file=/etc/loki/loki-config.yml
Memory=384M
PidsLimit=512
PodmanArgs=--oom-score-adj=500 --init

[Service]
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60
TimeoutStopSec=45

[Install]
WantedBy=default.target
