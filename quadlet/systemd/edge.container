HealthRetries=3
HealthStartPeriod=10s
Notify=healthy
Memory=192M
PidsLimit=512
Ulimit=nofile=65536:65536
PodmanArgs=--cpus=1.0

[Service]
TimeoutStartSec=175
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60

[Install]
