[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/nginxinc/nginx-unprivileged:1.31.7-alpine@sha256:b5047b9b76845eac124358373c6852377c52e4b05834a47647e955dd91cb8f1e
ContainerName=edge
LogDriver=journald
User=101
Group=101
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Tmpfs=/tmp:rw,noexec,nosuid,size=64m
Tmpfs=/var/cache/nginx:rw,noexec,nosuid,size=64m
PublishPort=127.0.0.1:8080:8080
PublishPort=[::1]:8080:8080
PublishPort=127.0.0.1:8443:8443
PublishPort=[::1]:8443:8443
Network=net-edge-ingress.network:ip=172.28.15.10
Network=net-proxy-frontend.network:ip=172.28.3.250
Network=net-proxy-keycloak.network:ip=172.28.4.250
Network=net-proxy-ingest.network:ip=172.28.7.250
Network=net-proxy-grafana.network:ip=172.28.11.250
Volume=/opt/basetool/docker/edge:/etc/nginx/edge:ro
Volume=edge-certs.volume:/etc/nginx/certs:ro
Volume=edge-acme-webroot.volume:/var/www/acme:ro
Volume=/etc/basetool/monitoring/certs/basetool-ca.crt:/etc/nginx/upstream-ca.crt:ro
Volume=/etc/basetool/monitoring/certs/grafana.crt:/etc/nginx/grafana-upstream.crt:ro
Volume=/opt/basetool/docker/maintenance/static:/usr/share/nginx/html/maintenance:ro
EnvironmentFile=/etc/basetool/env.d/edge.env
Exec=/bin/sh /etc/nginx/edge/render-and-run.sh
HealthCmd=wget -q -O /dev/null http://127.0.0.1:8081/healthz
HealthInterval=30s
