# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/redis:8-alpine@sha256:3811787313eba226a2ef38658c6ccb91cd5e110edc89c37767de373120a0e5a0
ContainerName=redis
LogDriver=journald
User=999
Group=999
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=net-redis-frontend.network
Network=net-redis-ingest.network
Network=net-redis-backend.network
Volume=/var/lib/basetool/redis:/data
Volume=/var/lib/basetool/redis/users.acl:/etc/redis/users.acl:ro
EnvironmentFile=/etc/basetool/env.d/redis.env
Exec=redis-server --save "60 1" --appendonly yes --appendfsync everysec --maxmemory 768mb --maxmemory-policy noeviction --notify-keyspace-events Egx --loglevel notice --aclfile /etc/redis/users.acl
HealthCmd=redis-cli ping 2>&1 | grep -q -e PONG -e NOAUTH
HealthInterval=5s
HealthTimeout=5s
HealthRetries=5
Notify=healthy
Memory=1024M
PidsLimit=512
PodmanArgs=--cpus=1.0
StopTimeout=30

[Service]
TimeoutStartSec=110
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60
TimeoutStopSec=45

[Install]
WantedBy=default.target
