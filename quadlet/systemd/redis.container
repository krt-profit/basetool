# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/redis:8-alpine@sha256:becdda6c7f4b3fb42e42fd7f120bbf5c54c4caaaf16f26da24e4563d2c1f0576
ContainerName=redis
DropCapability=ALL
AddCapability=CHOWN
AddCapability=DAC_OVERRIDE
AddCapability=FOWNER
AddCapability=SETGID
AddCapability=SETUID
NoNewPrivileges=true
Network=net-redis-frontend.network
Network=net-redis-ingest.network
Network=net-redis-backend.network
Volume=/var/iri/redis:/data
Volume=/var/iri/redis/users.acl:/etc/redis/users.acl:ro
EnvironmentFile=/var/iri/code/env.d/redis.env
Exec=redis-server --save "60 1" --appendonly yes --appendfsync everysec --maxmemory 384mb --maxmemory-policy noeviction --loglevel notice --aclfile /etc/redis/users.acl
HealthCmd=redis-cli -a ${REDIS_PASSWORD:?} --no-auth-warning ping
HealthInterval=5s
HealthTimeout=5s
HealthRetries=5
Notify=healthy
Memory=512M
PidsLimit=512
PodmanArgs=--cpus=1.0

[Service]
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60
TimeoutStopSec=30

[Install]
WantedBy=default.target
