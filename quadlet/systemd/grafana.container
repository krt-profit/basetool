# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/grafana/grafana:13.2.3@sha256:b28bae15e219c998fb0e0424ed724930cc61b1f61fb404d47c862f9a23f9e572
ContainerName=grafana
LogDriver=journald
ReadOnly=true
DropCapability=ALL
Environment=GF_PLUGINS_PREINSTALL_DISABLED=true
NoNewPrivileges=true
Network=net-monitoring-core.network
Network=net-proxy-grafana.network
Volume=/var/iri/code/monitoring/grafana/provisioning:/etc/grafana/provisioning:ro
Volume=/var/iri/code/monitoring/grafana/dashboards:/var/lib/grafana/dashboards:ro
Volume=/var/iri/monitoring/certs/grafana.crt:/etc/grafana/certs/grafana.crt:ro
Volume=/var/iri/monitoring/certs/grafana.key:/etc/grafana/certs/grafana.key:ro
Volume=/var/iri/monitoring/data/grafana:/var/lib/grafana
EnvironmentFile=/var/iri/code/env.d/grafana.env
HealthCmd=wget -q -O /dev/null --no-check-certificate https://localhost:3000/api/health || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=40s
Notify=healthy
Memory=1024M
PidsLimit=512
RunInit=true
PodmanArgs=--oom-score-adj=500

[Service]
TimeoutStartSec=300
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
