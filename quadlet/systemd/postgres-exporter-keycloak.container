# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
StartLimitIntervalSec=0

[Container]
Image=quay.io/prometheuscommunity/postgres-exporter:v0.21.1@sha256:a88794758ad461c75f3825b51cde4bde730bdff04b3b24d00efe14217e41f615
ContainerName=postgres-exporter-keycloak
LogDriver=journald
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=net-monitoring-scrape.network
Network=net-db-keycloak.network
EnvironmentFile=/etc/basetool/env.d/postgres-exporter-keycloak.env
Exec=--no-collector.stat_replication --collector.database_wraparound --collector.long_running_transactions
Memory=32M
PidsLimit=512
RunInit=true
PodmanArgs=--oom-score-adj=500

[Service]
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
