# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
After=backend.service redis.service
Requires=backend.service redis.service
StartLimitIntervalSec=0

[Container]
Image=ghcr.io/krt-profit/basetool-ingest:stable
ContainerName=ingest
LogDriver=journald
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=net-proxy-ingest.network
Network=net-backend-ingest.network
Network=net-redis-ingest.network
Network=net-monitoring-scrape.network
Volume=/var/iri/secrets/tls/ingest.p12:/run/secrets/keystore.p12:ro
Volume=/var/iri/secrets/tls/truststore.p12:/run/secrets/truststore.p12:ro
Volume=/var/iri/secrets/tls/truststore.p12:/run/secrets/internal-truststore.p12:ro
Volume=/var/iri/ingest/log:/app/logs
EnvironmentFile=/var/iri/code/env.d/ingest.env
HealthCmd=wget -q --no-check-certificate -O /dev/null https://localhost:11272/actuator/health/readiness
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=60s
HealthStartupInterval=5s
Notify=healthy
Memory=512M
PidsLimit=2048
RunInit=true
AddHost=localhost:127.0.0.1
AddHost=alloy:host-gateway
PodmanArgs=--cpus=1.5
StopTimeout=30

[Service]
TimeoutStartSec=225
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60
TimeoutStopSec=45

[Install]
WantedBy=default.target
