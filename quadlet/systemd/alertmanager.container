# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
StartLimitIntervalSec=0

[Container]
Image=quay.io/prometheus/alertmanager:v0.34.1@sha256:e9733bafb1bdef9b00e25a21f8f99dc26a22224bf16641ad754d1649f4c3357a
ContainerName=alertmanager
LogDriver=journald
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=net-monitoring-core.network
Volume=/var/iri/monitoring/secrets/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
Volume=/var/iri/monitoring/data/alertmanager:/alertmanager
EnvironmentFile=/var/iri/code/env.d/alertmanager.env
Exec=--config.file=/etc/alertmanager/alertmanager.yml --storage.path=/alertmanager --data.retention=744h
HealthCmd=wget -q -O /dev/null http://localhost:9093/-/ready || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=20s
Notify=healthy
Memory=48M
PidsLimit=512
RunInit=true
PodmanArgs=--oom-score-adj=500

[Service]
TimeoutStartSec=280
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
