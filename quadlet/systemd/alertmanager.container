# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
StartLimitIntervalSec=0

[Container]
Image=quay.io/prometheus/alertmanager:v0.34.2@sha256:39d8bb3966c694a124428a3a88fbcffd40bd069129ecd47c059f8a3f17c55f3b
ContainerName=alertmanager
LogDriver=journald
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=net-monitoring-core.network
Volume=/etc/basetool/monitoring/secrets/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
Volume=/var/lib/basetool/monitoring/alertmanager:/alertmanager
EnvironmentFile=/etc/basetool/env.d/alertmanager.env
Exec=--config.file=/etc/alertmanager/alertmanager.yml --storage.path=/alertmanager --data.retention=744h
HealthCmd=wget -q -O /dev/null http://localhost:9093/-/ready || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=20s
Notify=healthy
Memory=48M
PidsLimit=512
RunInit=true
PodmanArgs=--oom-score-adj=500

[Service]
TimeoutStartSec=280
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
