[Container]
Image=quay.io/prometheus/alertmanager:v0.34.0@sha256:690c7b525f4367aa91f73e2f91c632206d32e97c6384bdbf2fb7a861b420340d
ContainerName=alertmanager
DropCapability=ALL
NoNewPrivileges=true
Network=net-monitoring-core.network
Volume=/var/iri/monitoring/secrets/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
Volume=/var/iri/monitoring/data/alertmanager:/alertmanager
EnvironmentFile=/var/iri/code/env.d/alertmanager.env
Exec=--config.file=/etc/alertmanager/alertmanager.yml --storage.path=/alertmanager --data.retention=744h
HealthCmd=wget -q -O /dev/null http://localhost:9093/-/ready || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=20s
Notify=healthy
Memory=48M
PidsLimit=512
PodmanArgs=--oom-score-adj=500

[Service]
Restart=always

[Install]
WantedBy=default.target
