# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/postgres:18-alpine@sha256:d3e1620b530c944afa6e887d22eb899824da68e19c52024bf98f5220c88a65b2
ContainerName=db-keycloak
User=70
Group=70
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=net-db-keycloak.network
Volume=/var/iri/db-keycloak:/var/lib/postgresql/data
EnvironmentFile=/var/iri/code/env.d/db-keycloak.env
Exec=postgres -c shared_buffers=128MB -c effective_cache_size=384MB -c work_mem=4MB -c maintenance_work_mem=32MB -c max_connections=120 -c log_error_verbosity=terse -c log_line_prefix='%m [%p] %q%u@%d/%a '

HealthCmd=pg_isready -U ${POSTGRES_USER:?} -d ${POSTGRES_DB:?} -p 15433
HealthInterval=5s
HealthTimeout=5s
HealthRetries=5
Notify=healthy
Memory=512M
PidsLimit=512
PodmanArgs=--cpus=1.0

[Service]
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60
TimeoutStopSec=60

[Install]
WantedBy=default.target
