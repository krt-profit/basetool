[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/grafana/tempo:3.0.3@sha256:0296560ac66f8a3600d7fb3014a52c189d4d9c3549ad6ff441bf2409855d68d5
ContainerName=tempo
LogDriver=journald
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
PublishPort=127.0.0.1:4327:4317
Network=net-monitoring-core.network
Volume=/var/iri/code/monitoring/tempo/tempo.yaml:/etc/tempo/tempo.yaml:ro
Volume=/var/iri/monitoring/data/tempo:/var/tempo
EnvironmentFile=/var/iri/code/env.d/tempo.env
Exec=-target=all -config.expand-env=true -config.file=/etc/tempo/tempo.yaml
Memory=1G
PidsLimit=512
PodmanArgs=--oom-score-adj=500 --init

[Service]
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60
TimeoutStopSec=45

[Install]
WantedBy=default.target
