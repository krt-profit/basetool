[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/grafana/tempo:3.1.0@sha256:3076b8dcdfb32fd6bc5ccef85e7b7313e6199b9cb84366257fc17ecb696db5fd
ContainerName=tempo
LogDriver=journald
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
PublishPort=127.0.0.1:4327:4317
Network=net-monitoring-core.network
Volume=/var/iri/code/monitoring/tempo/tempo.yaml:/etc/tempo/tempo.yaml:ro
Volume=/var/iri/monitoring/data/tempo:/var/tempo
EnvironmentFile=/var/iri/code/env.d/tempo.env
Exec=-target=all -config.expand-env=true -config.file=/etc/tempo/tempo.yaml
Memory=1G
PidsLimit=512
RunInit=true
PodmanArgs=--oom-score-adj=500
StopTimeout=45

[Service]
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60
TimeoutStopSec=60

[Install]
WantedBy=default.target
