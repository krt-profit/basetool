# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
[Unit]
StartLimitIntervalSec=0

[Container]
Image=docker.io/grafana/tempo:3.1.1@sha256:64e2fbd56d9c2b3412a4b430a58ea59e91a670b1e75f920a0c702213ad145044
ContainerName=tempo
LogDriver=journald
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
PublishPort=127.0.0.1:4327:4317
Network=net-monitoring-core.network
Volume=/opt/basetool/monitoring/tempo/tempo.yaml:/etc/tempo/tempo.yaml:ro
Volume=/var/lib/basetool/monitoring/tempo:/var/tempo
EnvironmentFile=/etc/basetool/env.d/tempo.env
Exec=-target=all -config.expand-env=true -config.file=/etc/tempo/tempo.yaml
Memory=1G
PidsLimit=512
RunInit=true
PodmanArgs=--oom-score-adj=500
StopTimeout=45

[Service]
Restart=always
RestartSec=1
RestartSteps=6
RestartMaxDelaySec=60
TimeoutStopSec=60

[Install]
WantedBy=default.target
