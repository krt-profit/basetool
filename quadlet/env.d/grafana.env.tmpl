# Generated by scripts/generate-quadlet.py -- do not edit. Run the generator.
# The environment template for grafana. The deployer renders
# /var/iri/code/env.d/grafana.env from this, interpolating ${...} against the host
# .env the way compose did. A literal passes through; a ${NAME:-default} keeps its
# default when the host sets nothing; a ${NAME:?...} must be set or the render fails.
#
# NO SECRET IS IN THIS FILE. A secret appears as a reference, and its value exists only on
# the host -- which is also why this is one file per service: the compose environment maps
# are closed allow-lists, and one shared EnvironmentFile would hand every container every
# secret.
GF_ANALYTICS_CHECK_FOR_UPDATES=false
