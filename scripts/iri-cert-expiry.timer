[Unit]
Description=Profit Basetool — certificate expiry metrics, daily
Documentation=https://github.com/krt-profit/basetool/blob/main/scripts/cert-expiry-metrics.py

[Timer]
OnBootSec=5min
OnCalendar=*-*-* 03:40:00
RandomizedDelaySec=300

Persistent=true

Unit=iri-cert-expiry.service

[Install]
WantedBy=timers.target
