; systemd service for the weekly Profit Basetool restore drill (REQ-OPS-011).
;
; Installation is by the Ansible role (ansible/roles/basetool_host/tasks/25-scripts.yml), not by
; hand: it copies this unit and iri-restore-drill.timer to /etc/systemd/system/, verifies them with
; `systemd-analyze verify`, and enables the timer without starting it.
;
; Run an immediate drill:
;   sudo systemctl start iri-restore-drill.service
;   tail -f /var/log/iri-restore-drill.log   # the script output; journald has only the unit lifecycle
; Off-host: Grafana -> Explore -> Loki, `{app="ops-restore-drill"}`.
;
; Restores the latest off-site snapshot into a THROWAWAY Postgres container and
; verifies it. It never touches production state. A failure (unrestorable
; backup) makes the unit report `failed` and raises RestoreDrillArtifactNotRestorable
; / RestoreDrillStaleOrMissing (monitoring/prometheus/alerts/ops-automation.yml) —
; treat that as a sev incident.

[Unit]
Description=Profit Basetool — weekly restore drill (prove backups are recoverable)
Documentation=https://github.com/krt-profit/basetool/blob/main/docs/backup.md
Wants=network-online.target
After=network-online.target
# No dependency on the container runtime. What the job needs is the rootless service user's manager
# FINISHED starting, and only the script can wait on that signal -- rt_detect and
# rt_wait_for_startup in scripts/lib/container-runtime.sh. Measured on the first reboot after the
# 2026-09-22 cutover: the timers' Persistent=true catch-up fired eleven seconds after boot, one
# second before user@<uid>.service came up, and an `After=user@<uid>.service` would still have let
# the backup quiesce a stack that was starting. (These units carried `After=docker.service` until
# then, which ordered them on nothing on a Podman host.)

[Service]
Type=oneshot

User=deploy
# No Group=: systemd takes the account's own primary group. The deploy account reaches the
# containers through the sudoers rule of ansible/roles/basetool_host/tasks/22-deploy-user.yml, not
# through any group membership.

ExecStart=/var/iri/code/scripts/restore-drill.sh

StandardOutput=append:/var/log/iri-restore-drill.log
StandardError=append:/var/log/iri-restore-drill.log

; --- Hardening ----------------------------------------------------------------
; The sandbox all four deploy-account units share -- ProtectSystem=strict, ProtectHome=read-only,
; PrivateTmp, PrivateDevices, the kernel and cgroup protections -- is the drop-in
; 10-deploy-account-sandbox.conf the Ansible role installs beside this unit, from
; scripts/iri-deploy-account-sandbox.conf, together with why NoNewPrivileges and RestrictNamespaces
; are absent (OPS-SIMP-03). What follows is this job's own.
; Writable paths, and NOT the whole of /var/iri (narrowed 2026-09-22, OPS-SIMP-03): the drill
; restores into its own working tree under the backup directory and writes one textfile metric.
; The throwaway Postgres runs as the service user, outside this sandbox, so none of its writes need a
; path here -- and neither do the production data directories under /var/iri it must never touch.
;   /var/lib/iri                 — the restic cache (deploy has no usable $HOME)
;   /var/iri/backup              — the restore-drill working tree
;   /var/iri/monitoring/textfile — the basetool_restore_drill_* metrics
;   /var/log                     — append to iri-restore-drill.log
ReadWritePaths=/var/lib/iri /var/iri/backup /var/iri/monitoring/textfile /var/log

MemoryMax=1G
CPUQuota=200%

TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
