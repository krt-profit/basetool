[Unit]
Description=Profit Basetool — weekly container housekeeping (Sat 02:00 UTC)
Documentation=https://github.com/krt-profit/basetool/blob/main/docs/deployment.md

[Timer]
OnCalendar=Sat *-*-* 02:00:00 UTC

Persistent=true

RandomizedDelaySec=5min

Unit=iri-container-cleanup.service

[Install]
WantedBy=timers.target
