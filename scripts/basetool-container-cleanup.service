[Unit]
Description=Profit Basetool — weekly container housekeeping (prune unused containers/images/networks)
Documentation=https://github.com/krt-profit/basetool/blob/main/docs/deployment.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot

User=deploy

ExecStart=/opt/basetool/scripts/container-cleanup.sh

StandardOutput=append:/var/log/basetool/container-cleanup.log
StandardError=append:/var/log/basetool/container-cleanup.log

ReadWritePaths=/var/lib/basetool/textfile /var/log/basetool /run/lock

MemoryMax=1G
CPUQuota=200%

TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
