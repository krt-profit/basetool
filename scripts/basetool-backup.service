[Unit]
Description=Profit Basetool — nightly encrypted off-site backup to Nextcloud
Documentation=https://github.com/krt-profit/basetool/blob/main/docs/backup.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot

User=deploy

ExecStart=/opt/basetool/scripts/backup.sh

StandardOutput=append:/var/log/basetool/backup.log
StandardError=append:/var/log/basetool/backup.log

ReadWritePaths=/var/lib/basetool/deploy /var/lib/basetool/backup /var/lib/basetool/textfile /var/cache/basetool /var/log/basetool /run/lock

MemoryMax=1G
CPUQuota=200%

TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
