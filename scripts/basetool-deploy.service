[Unit]
Description=Profit Basetool — pull and apply latest GHCR images
Documentation=https://github.com/krt-profit/basetool/blob/main/docs/deployment.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot

User=deploy

ExecStart=/opt/basetool/scripts/deploy.sh

StandardOutput=append:/var/log/basetool/deploy.log
StandardError=append:/var/log/basetool/deploy.log

ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RemoveIPC=true
CapabilityBoundingSet=~CAP_SYS_ADMIN CAP_SYS_MODULE CAP_SYS_RAWIO CAP_SYS_BOOT CAP_SYS_TIME CAP_NET_ADMIN CAP_MAC_ADMIN CAP_MAC_OVERRIDE CAP_SYS_PTRACE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM
ReadWritePaths=/etc/containers/systemd/users /etc/basetool/env.d /var/lib/basetool/deploy /var/lib/basetool/textfile /var/log/basetool /run/lock /opt/basetool

MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=multi-user.target
