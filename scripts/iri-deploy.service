; systemd service for the periodic Profit Basetool deploy check.
;
; Installation (on the production host, one-time):
;   sudo cp /var/iri/code/scripts/iri-deploy.service /etc/systemd/system/
;   sudo cp /var/iri/code/scripts/iri-deploy.timer   /etc/systemd/system/
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now iri-deploy.timer
;
; Force an immediate run (bypassing the next scheduled tick):
;   sudo systemctl start iri-deploy.service
;
; Inspect:
;   systemctl status iri-deploy.timer
;   journalctl -u iri-deploy.service -f     # unit lifecycle ONLY — no script output, see below
;   tail -f /var/log/iri-deploy.log         # what the script actually printed
; Off-host (no SSH needed): Grafana -> Explore -> Loki, `{app="ops-deploy"}`.
;
; The unit deliberately runs as a dedicated `deploy` user (no shell, no sudo) —
; not as root. It is a member of the `docker` group so it can invoke
; `docker compose` without sudo. Be honest about what that bounds: docker-group
; membership is effectively root-equivalent on the host (the group can bind-mount
; `/` into a container and escape), so the `deploy` user is NOT a hard privilege
; boundary against a fully-compromised deploy.sh. What DOES bound the blast radius
; is: (1) the host-side cosign signature gate (REQ-OPS-015) — deploy.sh refuses to
; run an image not signed by our release-images identity, so a moved `:stable` tag
; or a compromised GHCR pull token cannot get attacker code executed here; and
; (2) the systemd sandbox below, which confines deploy.sh's own process.
; Further hardening deferred (would reduce the docker-group surface itself):
; routing docker access through a read-restricted docker-socket-proxy, or moving
; to rootless Docker. See docs/deployment.md → "Docker access hardening".

[Unit]
Description=Profit Basetool — pull and apply latest GHCR images
Documentation=https://github.com/krt-profit/basetool/blob/main/docs/deployment.md
Wants=network-online.target
After=network-online.target
# NO dependency on the container runtime here, and the reason changed on 2026-09-22.
#
# These four units used to carry `Wants=`/`After=docker.service`, kept on the grounds that an
# ordering on a unit that does not exist is inert. It was inert -- and it READ as if the unit were
# ordered on its runtime, which is how nobody noticed that on a rootless-Podman host nothing orders
# it on anything. The Docker host was retired at the 2026-09-22 cutover, so the line pointed at
# nothing on every host that remains. (`Requires=docker.service` was removed earlier still, because
# it made the units unstartable on Podman.)
#
# The comment beside it also said "a tick that fires while the runtime is still coming up costs one
# retry; the timer fires again". Measured on the first reboot after the cutover, that is wrong on
# both counts. The timers carry `Persistent=true`, so a catch-up run fires seconds after boot; it
# found no runtime and FAILED, SystemdUnitFailed paged critical, and the unit stayed failed until
# its next scheduled run -- the next night for the backup, the next week for the drill and the
# cleanup. The catch-up Persistent=true exists for was the run that was lost.
#
# What the job needs is the rootless service user's manager -- and not merely running, but FINISHED
# starting, because backup.sh quiesces the writers and container-cleanup.sh prunes. Measured on the
# same boot: user@994.service was active at 16:26:03, the stack at 16:27:33. So an
# `After=user@<uid>.service` here would have fixed the detection and let the backup stop the
# backend while it was still coming up. Only the script can wait on the right signal, and only the
# script knows the uid -- scripts/lib/container-runtime.sh, rt_detect and rt_wait_for_startup.

[Service]
Type=oneshot

# The `deploy` user is created during host bootstrap (see docs/deployment.md).
# Group `docker` is required to invoke `docker compose` without sudo. The
# user has NO sudo grants and a `/sbin/nologin` shell — interactive use is
# impossible.
User=deploy
# NOT `Group=docker`. That group does not exist on a rootless-Podman host, and a unit naming a
# group that does not exist refuses to start -- so all four of these were unstartable on the
# platform the migration moves to.
#
# Removing it costs nothing on the Docker host: read from production 2026-09-18, the account is
# `uid=999(deploy) gid=987(deploy) groups=987(deploy),988(docker)`, so it already CARRIES the
# membership. With `User=` and no `Group=`, systemd takes the user's own primary group and
# initialises its supplementary groups from the user database -- docker among them. The directive
# was pinning what the account already had.
#
# On the Podman host the socket is not the path at all: the deploy account reaches the containers
# through a sudoers rule naming two commands against the service user
# (ansible/roles/basetool_host/tasks/22-deploy-user.yml), which is strictly narrower than docker
# group membership, that being root-equivalent by design.

ExecStart=/var/iri/code/scripts/deploy.sh

# Send stdout/stderr to /var/log/iri-deploy.log, where logrotate keeps human-readable
# history for post-mortems beyond the journald retention window.
#
# `append:` REPLACES journald for these two streams — it does NOT tee to it. So
# `journalctl -u iri-deploy.service` shows only systemd's own unit records (Starting /
# Succeeded / Failed / the exit code) and NOT a single line deploy.sh printed. Read the
# script output from /var/log/iri-deploy.log, or — without an SSH session — from Loki:
# Alloy tails this file as `{app="ops-deploy"}` (monitoring/alloy/config.alloy), which is
# where the DeployRolledBack / DeployFailed alert annotations now point. Do not "fix" this
# by switching to `journal+file:` or dropping the redirection: logrotate's copytruncate
# strategy here is written against the held-open append fd, and the Loki tail is now the
# documented triage path.
StandardOutput=append:/var/log/iri-deploy.log
StandardError=append:/var/log/iri-deploy.log

# --- Hardening -------------------------------------------------------------
# Defence-in-depth: the deploy user is already unprivileged, but if a bug
; in deploy.sh or a malicious tag in GHCR triggered code execution inside
; the unit's process, these directives bound the damage radius.
; NOT NoNewPrivileges=true, and the reason is the whole point of this unit.
;
; This service's job is to act AS ANOTHER USER: under rootless Podman the containers belong to the
; service account, and the deploy account reaches them through a sudoers rule naming two commands
; against that one user (ansible/roles/basetool_host/tasks/22-deploy-user.yml). NoNewPrivileges
; forbids exactly that, and sudo says so rather than failing quietly:
;
;     sudo: The "no new privileges" flag is set, which prevents sudo from running as root.
;
; Measured on the testing host 2026-09-18: without the flag the same call lists all eleven
; containers; with it, the runtime detection finds no user that owns any and the unit dies with
; "podman is installed but no lingering user could be found". All four operational units carried
; the flag, so none of them could ever have run on the platform this migration moves to.
;
; What is NOT lost. The privilege boundary was never this flag -- it is the sudoers rule, which
; names two commands and one target user and is strictly narrower than the `Group=docker` this
; replaces (that group is root-equivalent by design: it can bind-mount / into a privileged
; container). Everything else below stays: ProtectSystem=strict, ProtectHome, PrivateTmp,
; PrivateDevices, the kernel protections, RestrictNamespaces, and a ReadWritePaths list of four
; directories.
;
; On the Docker host the flag was compatible because group membership is not a privilege GAIN.
; It is removed on both, so the two deployments stay one file.
ProtectSystem=strict
; ProtectHome=read-only, NOT true. `true` makes /home an inaccessible empty tmpfs, and rootless
; podman has to resolve the SERVICE user's home to find its container store:
;
;     cannot resolve /home/iri: lstat /home/iri: permission denied
;
; read-only keeps the protection that matters here -- this unit has no business writing into
; anybody's home -- and was measured working on the testing host 2026-09-18, against a baseline
; taken seconds earlier so a transient rootless-podman state could not be mistaken for a verdict.
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
; NOT RestrictNamespaces=true. Rootless Podman IS a user namespace: the flag makes the container
; runtime fail with "cannot set user namespace" before it reaches any container. There is no
; narrower form that works -- `RestrictNamespaces=user` fails identically, because podman needs
; mount, pid, ipc, net and uts as well.
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
LockPersonality=true
# NOT emptied, which is what it was. Under Docker the reasoning held: deploy.sh talks to a socket
# and the root daemon acts out-of-band, so the script itself needs no capability. Under rootless
# Podman it has to BECOME the service user, and sudo says exactly what an empty set costs:
#
#     sudo: unable to change to root gid: Operation not permitted
#
# Measured on the testing host 2026-09-18. A narrow allowlist was tried first and is not enough
# either -- CAP_SETUID/CAP_SETGID alone gets past the gid change and then dies in sudo's PAM
# stack ("Authentication service cannot retrieve authentication info"), which needs more than the
# switch itself. So the form is a BLOCKLIST: everything stays available except the capabilities
# that would let this account reconfigure the host, load code into the kernel, or read another
# process's memory. That is a real restriction, and it is one that can be stated exactly.
CapabilityBoundingSet=~CAP_SYS_ADMIN CAP_SYS_MODULE CAP_SYS_RAWIO CAP_SYS_BOOT CAP_SYS_TIME CAP_NET_ADMIN CAP_MAC_ADMIN CAP_MAC_OVERRIDE CAP_SYS_PTRACE
# The script talks to the docker socket over AF_UNIX and makes outbound HTTPS
# (GHCR pulls + cosign's Sigstore reach) over AF_INET/AF_INET6; AF_NETLINK covers
# routing/interface lookups the CLIs do at startup. Everything else is denied.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
# Confine to the syscall set a normal service needs (blocks @obsolete, @privileged,
# raw @swap/@reboot etc.). docker CLI, cosign and the coreutils/bash the script
# drives all fall inside @system-service. If a future tool trips this,
# `deploy.sh --check-only` surfaces it before a real deploy — widen or comment it
# out then, do not weaken the rest of the sandbox.
#
# `@mount` is the one widening, and it is what that instruction anticipated. Rootless Podman sets
# up its container's filesystem itself, in a user namespace, with the mount family that
# @system-service deliberately excludes. Without it the call dies under seccomp with no message at
# all -- the process is killed, so nothing is written to say why, which is the least helpful
# failure in this whole file. Measured 2026-09-18: `@system-service` fails silently,
# `@system-service @mount` succeeds.
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM
# The script writes ONLY to these paths (everything else is read-only under
# ProtectSystem=strict). Deliberately NOT the whole /var/iri: the DB / redis / npm
# bind mounts under /var/iri are written by the containers via the root daemon,
# out-of-band from this sandbox, so deploy.sh needs no write access to them.
#   /var/lib/iri/       — state files (digest pins, last-deployed marker, the
#                         config-stage/ + config-previous/ dirs, config-blocked.marker,
#                         the DOCKER_CONFIG credential + the $HOME/.sigstore cosign cache)
#   /var/log/           — append to iri-deploy.log
#   /var/lock/          — flock file
#   /var/iri/code/      — where the config bundle is applied (docker-compose.yml +
#                         maintenance/theme trees) and the keycloak provider JAR is staged
#   /var/iri/monitoring — the node_exporter textfile dir deploy.sh writes metrics into
#                         (absent on a host without monitoring → the metric write
#                         degrades to a best-effort no-op)
# /etc/containers/systemd/users is where a RELEASE installs the Quadlet units and where this
# script writes each service's digest-pin drop-in. ProtectSystem=strict makes everything
# outside this list read-only, and the run died on
#   mkdir: cannot create directory '.../992/backend.container.d': Read-only file system
# right after the signatures verified -- the last step before anything would have been
# applied. The DIRECTORY, not the per-user subdirectory: the uid is not known to a static
# unit file, and the parent is root-owned so only the delivery directory inside it is
# writable by this account anyway.
ReadWritePaths=/etc/containers/systemd/users /var/lib/iri /var/log /var/lock /var/iri/code /var/iri/monitoring

# Hard memory and CPU caps so a runaway script cannot starve the production
; stack of resources during a deploy. Generous on purpose — the actual work
; is delegated to docker, the script itself is a thin wrapper.
MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=multi-user.target
