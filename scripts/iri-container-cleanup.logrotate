# logrotate(8) configuration for /var/log/iri-container-cleanup.log.
#
# Installed to /etc/logrotate.d/iri-container-cleanup (root:root 0644) by
# ansible/roles/basetool_host/tasks/25-scripts.yml — not by hand.
#
# Manual test (a dry run, it rotates nothing):
#   sudo logrotate --debug /etc/logrotate.d/iri-container-cleanup
#
# `copytruncate` is required because iri-container-cleanup.service appends via
# `StandardOutput=append:...`, holding the fd open across its run — a naive
# `create` (rename + recreate) would leave systemd writing into the rotated file.
#
# logrotate ignores `create` when `copytruncate` is set: the live file stays in
# place and keeps whatever owner and mode it already has.

/var/log/iri-container-cleanup.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 0640 deploy adm
}
