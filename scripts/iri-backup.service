; systemd service for the nightly Profit Basetool off-site backup.
;
; Installation (on the production host, one-time — see docs/backup.md):
;   sudo cp /var/iri/code/scripts/iri-backup.service /etc/systemd/system/
;   sudo cp /var/iri/code/scripts/iri-backup.timer   /etc/systemd/system/
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now iri-backup.timer
;
; Run an immediate backup (bypassing the next scheduled tick):
;   sudo systemctl start iri-backup.service
;
; Inspect:
;   systemctl status iri-backup.timer
;   journalctl -u iri-backup.service -f
;
; Runs as the same unprivileged `deploy` user as iri-deploy (member of the
; `docker` group, no shell, no sudo): it needs Docker (stop/start/exec/run) and
; read access to the host config, nothing more. The root-owned NPM bind mount
; is read via a throwaway root container, not by this user directly.

[Unit]
Description=Profit Basetool — nightly encrypted off-site backup to Nextcloud
Documentation=https://github.com/krt-profit/basetool/blob/main/docs/backup.md
Wants=network-online.target docker.service
After=network-online.target docker.service
# NOT `Requires=docker.service`. That line made all four of these units refuse to start on a
# rootless-Podman host -- "Failed to create iri-deploy.service/start: Unit docker.service not
# found" -- which is where the migration would have discovered it, on the new production host,
# with the timers already enabled.
#
# Nothing replaces it, deliberately. The runtime is DETECTED by the script
# (scripts/lib/container-runtime.sh), which refuses loudly when neither docker nor podman answers
# -- a better failure than a unit that never ran, because it says which host is wrong and why. A
# tick that fires while the runtime is still coming up costs one retry; the timer fires again.
#
# `Wants=`/`After=docker.service` are kept: an ordering or weak dependency on a unit that does not
# exist is inert, and on the Docker host it still orders correctly.

[Service]
Type=oneshot

User=deploy
# NOT `Group=docker`. That group does not exist on a rootless-Podman host, and a unit naming a
# group that does not exist refuses to start -- so all four of these were unstartable on the
# platform the migration moves to.
#
# Removing it costs nothing on the Docker host: read from production 2026-09-18, the account is
# `uid=999(deploy) gid=987(deploy) groups=987(deploy),988(docker)`, so it already CARRIES the
# membership. With `User=` and no `Group=`, systemd takes the user's own primary group and
# initialises its supplementary groups from the user database -- docker among them. The directive
# was pinning what the account already had.
#
# On the Podman host the socket is not the path at all: the deploy account reaches the containers
# through a sudoers rule naming two commands against the service user
# (ansible/roles/basetool_host/tasks/22-deploy-user.yml), which is strictly narrower than docker
# group membership, that being root-equivalent by design.

ExecStart=/var/iri/code/scripts/backup.sh

; stdout/stderr to journald AND to /var/log/iri-backup.log for logrotate-kept history.
StandardOutput=append:/var/log/iri-backup.log
StandardError=append:/var/log/iri-backup.log

; --- Hardening (mirrors iri-deploy.service) --------------------------------
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
; Writable paths the script needs:
;   /var/lib/iri — restic cache + docker config (deploy has no usable $HOME)
;   /var/iri     — the /var/iri/backup staging tree (Docker volume hierarchy)
;   /var/log     — append to iri-backup.log
;   /var/lock    — the shared deploy flock
; /etc/iri/backup.env is read-only (default under ProtectSystem=strict) — fine, we only read it.
ReadWritePaths=/var/lib/iri /var/iri /var/log /var/lock

; restic + a brief pg_dump are light on this host; cap generously. The heavy
; lifting is delegated to docker and the restic process.
MemoryMax=1G
CPUQuota=200%

; A failed backup must be loud, not silent. (Wire an OnFailure= alerting unit
; here if/when one exists — see docs/backup.md.)
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
