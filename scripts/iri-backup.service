; systemd service for the nightly Profit Basetool off-site backup.
;
; Installation is by the Ansible role (ansible/roles/basetool_host/tasks/25-scripts.yml), not by
; hand: it copies this unit and iri-backup.timer to /etc/systemd/system/, verifies them with
; `systemd-analyze verify`, and enables the timer without starting it.
;
; Run an immediate backup (bypassing the next scheduled tick):
;   sudo systemctl start iri-backup.service
;
; Inspect:
;   systemctl status iri-backup.timer
;   journalctl -u iri-backup.service -f     # unit lifecycle ONLY -- no script output
;   tail -f /var/log/iri-backup.log         # what the script actually printed
; Off-host (no SSH needed): Grafana -> Explore -> Loki, `{app="ops-backup"}`.
;
; Runs as the same unprivileged `deploy` user as iri-deploy (no shell, no password sudo): it drives
; the service user's containers (stop/start/exec/run) through the sudoers bridge of
; ansible/roles/basetool_host/tasks/22-deploy-user.yml and reads the host config, nothing more.
; What it cannot open itself -- the edge's certificate volumes, the keystore, grafana.db -- is
; streamed out through a throwaway helper container (rt_read_mount in
; scripts/lib/container-runtime.sh), not read by this user directly.

[Unit]
Description=Profit Basetool — nightly encrypted off-site backup to Nextcloud
Documentation=https://github.com/krt-profit/basetool/blob/main/docs/backup.md
Wants=network-online.target
After=network-online.target
# NO dependency on the container runtime here, and the reason changed on 2026-09-22.
#
# These four units used to carry `Wants=`/`After=docker.service`, kept on the grounds that an
# ordering on a unit that does not exist is inert. It was inert -- and it READ as if the unit were
# ordered on its runtime, which is how nobody noticed that on a rootless-Podman host nothing orders
# it on anything. The Docker host was retired at the 2026-09-22 cutover, so the line pointed at
# nothing on every host that remains. (`Requires=docker.service` was removed earlier still, because
# it made the units unstartable on Podman.)
#
# The comment beside it also said "a tick that fires while the runtime is still coming up costs one
# retry; the timer fires again". Measured on the first reboot after the cutover, that is wrong on
# both counts. The timers carry `Persistent=true`, so a catch-up run fires seconds after boot; it
# found no runtime and FAILED, SystemdUnitFailed paged critical, and the unit stayed failed until
# its next scheduled run -- the next night for the backup, the next week for the drill and the
# cleanup. The catch-up Persistent=true exists for was the run that was lost.
#
# What the job needs is the rootless service user's manager -- and not merely running, but FINISHED
# starting, because backup.sh quiesces the writers and container-cleanup.sh prunes. Measured on the
# same boot: user@994.service was active at 16:26:03, the stack at 16:27:33. So an
# `After=user@<uid>.service` here would have fixed the detection and let the backup stop the
# backend while it was still coming up. Only the script can wait on the right signal, and only the
# script knows the uid -- scripts/lib/container-runtime.sh, rt_detect and rt_wait_for_startup.

[Service]
Type=oneshot

User=deploy
# NOT `Group=docker`. That group does not exist on a rootless-Podman host, and a unit naming a
# group that does not exist refuses to start -- so all four of these were unstartable on the
# platform the migration moves to.
#
# Removing it costs nothing on the Docker host: read from production 2026-09-18, the account is
# `uid=999(deploy) gid=987(deploy) groups=987(deploy),988(docker)`, so it already CARRIES the
# membership. With `User=` and no `Group=`, systemd takes the user's own primary group and
# initialises its supplementary groups from the user database -- docker among them. The directive
# was pinning what the account already had.
#
# On the Podman host the socket is not the path at all: the deploy account reaches the containers
# through a sudoers rule naming two commands against the service user
# (ansible/roles/basetool_host/tasks/22-deploy-user.yml), which is strictly narrower than docker
# group membership, that being root-equivalent by design.

ExecStart=/var/iri/code/scripts/backup.sh

; stdout/stderr to /var/log/iri-backup.log for logrotate-kept history. `append:` REPLACES
; journald for these streams rather than teeing to it (see iri-deploy.service).
StandardOutput=append:/var/log/iri-backup.log
StandardError=append:/var/log/iri-backup.log

; --- Hardening (mirrors iri-deploy.service) --------------------------------
; NOT NoNewPrivileges=true, and the reason is the whole point of this unit.
;
; This service's job is to act AS ANOTHER USER: under rootless Podman the containers belong to the
; service account, and the deploy account reaches them through a sudoers rule naming two commands
; against that one user (ansible/roles/basetool_host/tasks/22-deploy-user.yml). NoNewPrivileges
; forbids exactly that, and sudo says so rather than failing quietly:
;
;     sudo: The "no new privileges" flag is set, which prevents sudo from running as root.
;
; Measured on the testing host 2026-09-18: without the flag the same call lists all eleven
; containers; with it, the runtime detection finds no user that owns any and the unit dies with
; "podman is installed but no lingering user could be found". All four operational units carried
; the flag, so none of them could ever have run on the platform this migration moves to.
;
; What is NOT lost. The privilege boundary was never this flag -- it is the sudoers rule, which
; names two commands and one target user and is strictly narrower than the `Group=docker` this
; replaces (that group is root-equivalent by design: it can bind-mount / into a privileged
; container). Everything else below stays: ProtectSystem=strict, ProtectHome, PrivateTmp,
; PrivateDevices, the kernel protections, RestrictNamespaces, and a ReadWritePaths list of four
; directories.
;
; On the Docker host the flag was compatible because group membership is not a privilege GAIN.
; It is removed on both, so the two deployments stay one file.
ProtectSystem=strict
; ProtectHome=read-only, NOT true. `true` makes /home an inaccessible empty tmpfs, and rootless
; podman has to resolve the SERVICE user's home to find its container store:
;
;     cannot resolve /home/iri: lstat /home/iri: permission denied
;
; read-only keeps the protection that matters here -- this unit has no business writing into
; anybody's home -- and was measured working on the testing host 2026-09-18, against a baseline
; taken seconds earlier so a transient rootless-podman state could not be mistaken for a verdict.
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
; NOT RestrictNamespaces=true. Rootless Podman IS a user namespace: the flag makes the container
; runtime fail with "cannot set user namespace" before it reaches any container. There is no
; narrower form that works -- `RestrictNamespaces=user` fails identically, because podman needs
; mount, pid, ipc, net and uts as well.
RestrictRealtime=true
LockPersonality=true
; Writable paths the script needs:
;   /var/lib/iri — restic cache + docker config (deploy has no usable $HOME)
;   /var/iri     — the /var/iri/backup staging tree
;   /var/log     — append to iri-backup.log
;   /var/lock    — the shared deploy flock
; /etc/iri/backup.env is read-only (default under ProtectSystem=strict) — fine, we only read it.
ReadWritePaths=/var/lib/iri /var/iri /var/log /var/lock

; restic + a brief pg_dump are light on this host; cap generously. The heavy
; lifting is delegated to the container runtime and the restic process.
MemoryMax=1G
CPUQuota=200%

; A failed backup must be loud, not silent -- and it is, without an OnFailure= unit: backup.sh
; writes its outcome as node_exporter textfile metrics, and BackupStaleOrMissing
; (monitoring/prometheus/alerts/ops-automation.yml) fires on a success older than 26h or on the
; metric being absent, which covers a failed run, a timed-out run and a unit that never fired.
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
