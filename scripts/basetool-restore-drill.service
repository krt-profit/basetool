[Unit]
Description=Profit Basetool — weekly restore drill (prove backups are recoverable)
Documentation=https://github.com/krt-profit/basetool/blob/main/docs/backup.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot

User=deploy

ExecStart=/opt/basetool/scripts/restore-drill.sh

StandardOutput=append:/var/log/basetool/restore-drill.log
StandardError=append:/var/log/basetool/restore-drill.log

ReadWritePaths=/var/lib/basetool/deploy /var/lib/basetool/backup /var/lib/basetool/textfile /var/cache/basetool /var/log/basetool

MemoryMax=1G
CPUQuota=200%

TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
