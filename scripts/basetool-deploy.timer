[Unit]
Description=Profit Basetool — periodic deploy check (every 5 minutes, on the wall-clock grid)
Documentation=https://github.com/krt-profit/basetool/blob/main/docs/deployment.md

[Timer]
OnCalendar=*-*-* *:00/5:00

AccuracySec=1s

RandomizedDelaySec=0

Persistent=false

Unit=basetool-deploy.service

[Install]
WantedBy=timers.target
