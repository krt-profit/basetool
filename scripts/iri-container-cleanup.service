; systemd service for the weekly Profit Basetool container housekeeping.
;
; Installation is by the Ansible role (ansible/roles/basetool_host/tasks/25-scripts.yml), not by
; hand: it copies this unit and iri-container-cleanup.timer to /etc/systemd/system/, verifies them
; with `systemd-analyze verify`, and enables the timer without starting it.
;
; Run an immediate cleanup (bypassing the next scheduled tick):
;   sudo systemctl start iri-container-cleanup.service
;
; Inspect:
;   systemctl status iri-container-cleanup.timer
;   tail -f /var/log/iri-container-cleanup.log   # the script output; journald has only the unit lifecycle
; Off-host: Grafana -> Explore -> Loki, `{app="ops-cleanup"}`.
;
; Runs as the same unprivileged `deploy` user as iri-backup / iri-deploy (no shell, no password
; sudo): it prunes the service user's stopped containers, unused images and networks through the sudoers bridge of
; ansible/roles/basetool_host/tasks/22-deploy-user.yml, nothing more.

[Unit]
Description=Profit Basetool — weekly container housekeeping (prune unused containers/images/networks)
Documentation=https://github.com/krt-profit/basetool/blob/main/docs/deployment.md
Wants=network-online.target
After=network-online.target
# No dependency on the container runtime. What the job needs is the rootless service user's manager
# FINISHED starting, and only the script can wait on that signal -- rt_detect and
# rt_wait_for_startup in scripts/lib/container-runtime.sh. Measured on the first reboot after the
# 2026-09-22 cutover: the timers' Persistent=true catch-up fired eleven seconds after boot, one
# second before user@<uid>.service came up, and an `After=user@<uid>.service` would still have let
# the backup quiesce a stack that was starting. (These units carried `After=docker.service` until
# then, which ordered them on nothing on a Podman host.)

[Service]
Type=oneshot

User=deploy
# No Group=: systemd takes the account's own primary group. The deploy account reaches the
# containers through the sudoers rule of ansible/roles/basetool_host/tasks/22-deploy-user.yml, not
# through any group membership.


ExecStart=/var/iri/code/scripts/container-cleanup.sh

; stdout/stderr to /var/log/iri-container-cleanup.log for logrotate-kept history.
; `append:` REPLACES journald for these streams rather than teeing to it.
StandardOutput=append:/var/log/iri-container-cleanup.log
StandardError=append:/var/log/iri-container-cleanup.log

; --- Hardening ----------------------------------------------------------------
; The sandbox all four deploy-account units share -- ProtectSystem=strict, ProtectHome=read-only,
; PrivateTmp, PrivateDevices, the kernel and cgroup protections -- is the drop-in
; 10-deploy-account-sandbox.conf the Ansible role installs beside this unit, from
; scripts/iri-deploy-account-sandbox.conf, together with why NoNewPrivileges and RestrictNamespaces
; are absent (OPS-SIMP-03). What follows is this job's own.
; Writable paths the script needs:
;   /var/iri/monitoring — the node_exporter textfile dir the script writes the
;                         basetool_container_cleanup_* metrics into
;   /var/log            — append to iri-container-cleanup.log
;   /var/lock           — the container-cleanup flock
; (/var/lib/iri left the list on 2026-09-22 with DOCKER_CONFIG, the only thing this job kept there.)
ReadWritePaths=/var/iri/monitoring /var/log /var/lock

; Pruning is light on this host; cap generously. The heavy lifting happens inside the container
; runtime, out-of-band from this sandbox.
MemoryMax=1G
CPUQuota=200%

TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
