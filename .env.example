# Copy this file to .env and fill in real values.
# .env must NEVER be committed.
# Generate strong passwords, e.g.:  openssl rand -base64 32
#
# All values below are required (docker-compose will fail-fast if any is missing).

# Backend Database configuration
POSTGRES_DB=krt_basetool
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# Keycloak Database configuration
KC_POSTGRES_DB=keycloak
KC_POSTGRES_USER=CHANGE_ME
KC_POSTGRES_PASSWORD=CHANGE_ME

# Keycloak Initial Admin User
KC_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# Keycloak admin-API client secret (used by backend to sync users).
# Get / rotate this in the Keycloak admin console:
#   Realm "iri" -> Clients -> backend-service -> Credentials -> Regenerate.
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME

# Optional: cadence of the periodic Keycloak->local user sync. Spring 6-field cron
# (sec min hour dom mon dow) evaluated in APP_KEYCLOAK_SYNC_ZONE. Default: once per
# day at 05:00 Europe/Berlin (off-peak). The sync is a drift-correction safety net,
# not a live feed; admins trigger an immediate refresh from the member-management
# page's "Sync now" button. An invalid cron fails startup.
#APP_KEYCLOAK_SYNC_CRON=0 0 5 * * *
#APP_KEYCLOAK_SYNC_ZONE=Europe/Berlin

# PKCS12 keystore password for backend + frontend Spring SSL.
# The keystore file itself (keystore.p12) is .gitignore'd and must be
# provided out-of-band as a bind mount (see IRI_KEYSTORE_HOST_PATH below) —
# the keystore is NEVER baked into the GHCR image (see CLAUDE.md and the
# .dockerignore at the repo root for the threat model).
SERVER_SSL_KEY_STORE_PASSWORD=CHANGE_ME

# Absolute host path to the production keystore.p12. Bind-mounted read-only
# into both backend and frontend containers at /run/secrets/keystore.p12.
# Owner should be the runtime user (uid 10001) or `o+r` so the JVM can read
# the file. On a production host the canonical location is
# /var/iri/secrets/keystore.p12; for local dev, the default (`./keystore.p12`)
# resolves relative to docker-compose.yml and a generated test keystore at
# the repo root works out of the box.
IRI_KEYSTORE_HOST_PATH=/var/iri/secrets/keystore.p12

# Host IP for outbound binding (set to the deployment host IP)
HOST_IP=CHANGE_ME

# Redis password
REDIS_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Image-pull configuration (consumed by docker-compose.yml on the prod host)
# ---------------------------------------------------------------------------
# GHCR namespace that owns the basetool-backend / basetool-frontend packages.
# Default `krt-profit` matches the GitHub organisation that publishes the
# production images via .github/workflows/release-images.yml — override only
# when running against a fork's own GHCR namespace.
IRI_IMAGE_NAMESPACE=krt-profit

# Version pointer that resolves to a concrete GHCR tag. The deploy.sh script
# leaves this unset by default so the host follows the rolling `:stable`
# pointer that is updated atomically by .github/workflows/promote.yml.
# Pin to a specific version (`1.4.2`, `sha-abc1234`, ...) to roll back or
# stage an earlier release. Tags are immutable per digest, so a pinned
# version always resolves to the same image.
#IRI_BASETOOL_VERSION=stable

# ---------------------------------------------------------------------------
# Ingest gateway (epic #639 — desktop one-click send). Both optional.
# ---------------------------------------------------------------------------
# Public frontend URL the gateway sends the extractor's browser to
# (…?handoff=<id>). Defaults to https://profit-base.online; set to your
# frontend's public origin (local dev stack: http://localhost:18081).
#IRI_FRONTEND_PUBLIC_URL=https://profit-base.online
#
# JWT audience enforcement (security review, audit L-1). Empty/unset = OFF, so
# the backend and ingest accept any validly-signed token from the realm. To
# enforce in PROD that they accept ONLY tokens minted with aud=basetool-backend,
# set BOTH vars below to basetool-backend — but ONLY after confirming a real
# access token's `aud` carries basetool-backend on the deployed realm. The
# realm's `extractor-ingest` client scope (a default scope on both the
# basetool-frontend and basetool-sc-extractor clients, see
# docs/keycloak/realm-config.reference.json) stamps it, so every token the
# services receive should already carry it. Enabling either before the realm is
# verified rejects every token and breaks the app; unset a var to disable it
# instantly. Runbook: docs/INGEST_KEYCLOAK_SETUP.md.
#
# The MECHANISM no longer needs a prod first-run to be trusted: the E2E stack
# runs the backend with enforcement ON against a realm that stamps the audience,
# so the enforced decoder + aud validator are exercised end to end on every
# e2e-labelled PR. What the E2E run cannot tell you is whether the DEPLOYED
# realm stamps it — that is the one check left before flipping these on, and
# it is a read-only Keycloak query (INGEST_KEYCLOAK_SETUP.md step 5), not a
# token paste into a third-party decoder.
#IRI_BACKEND_EXPECTED_AUDIENCES=basetool-backend
#IRI_INGEST_EXPECTED_AUDIENCES=basetool-backend
#
# --- Client-identity gate (REQ-INGEST-011) ---------------------------------
# THE INGEST INTERFACE IS RESTRICTED TO CLIENTS APPROVED BY THE BASETOOL
# DEVELOPER (@greluc). Approving a client = a dedicated Keycloak client
# registration AND an entry in the allowlist below. Two independent gates;
# removing the allowlist entry revokes a client within one access-token
# lifespan, without a Keycloak change or a release.
#
# Every value below is EMPTY by default, which makes each check INERT. That is
# deliberate: the Keycloak-side mappers/scopes are an operator step, so shipping
# these pre-enabled would reject every real extractor token on deploy.
# Configure -> run with AUDIT_ONLY=true -> watch
# basetool_ingest_client_rejected_total stay at zero -> then enforce.
# Runbook: docs/INGEST_KEYCLOAK_SETUP.md step 7.
#
# Keycloak client ids (azp) allowed to call /v1/**. Comma-separated; several at
# once make a client-id rotation possible without downtime.
#IRI_INGEST_ALLOWED_CLIENT_IDS=basetool-sc-extractor
#
# OAuth scope an ingest token must carry. MUST be a scope the extractor has,
# the FRONTEND does not, and that is emitted into the `scope` claim. The shipped
# `extractor-ingest` scope fails BOTH: it is a default scope on both clients AND
# it carries include.in.token.scope=false, so setting it here would reject every
# caller including the real extractor (see runbook 7a).
#IRI_INGEST_REQUIRED_SCOPE=extractor-ingest-only
#
# Accepted payload `tool` provenance. Client-supplied and therefore forgeable —
# telemetry with a reject attached, never authentication.
#
# BOTH values are required: the extractor emits a DIFFERENT `tool` string per
# export path — `basetool-sc-extractor` on the refinery path, but the display
# name `Basetool SC Extractor` on the blueprint path. Listing only the slug
# rejects every blueprint send with 403 CLIENT_NOT_ALLOWED (incident 2026-08-03).
# The comparison folds case, so casing drift alone is tolerated; these two differ
# structurally and must both be listed.
#IRI_INGEST_ALLOWED_TOOLS=basetool-sc-extractor,Basetool SC Extractor
#
# true = run every configured check but never reject (log + count only).
#IRI_INGEST_CLIENT_AUDIT_ONLY=false

# ---------------------------------------------------------------------------
# Discord login (epic #720) — optional nickname capture for the approval queue
# ---------------------------------------------------------------------------
# The das-kartell Discord guild (server) id. When set, the Keycloak Discord SPI
# captures each member's per-guild server nickname and shows it in the admin
# registration-approval queue (REQ-DATA-008). Leave UNSET to disable nickname
# capture (fail-open — it never affects the login). Surfacing it also needs the
# two Keycloak mappers from docs/keycloak/DISCORD_KEYCLOAK_SETUP.md §3c.
# Discord client -> Developer Mode -> right-click the server -> Copy Server ID.
#DISCORD_GUILD_ID=

# Discord first-login account-existence precheck (REQ-SEC-022, ADR-0051). When set, a brand-new
# Discord first-login whose username / server nickname / e-mail already matches an existing account
# is denied with a localized "link your existing account instead" page, preventing duplicate
# accounts. Entirely fail-open: leave the values UNSET to disable the precheck (login behaves as
# before). HTTPS ONLY — never plain HTTP.
#
# Shared secret, set to the SAME value on BOTH the backend (guards /internal/discord/account-existence)
# and the Keycloak SPI (presents it in the X-KRT-SPI-Secret header). Generate a long random value.
#KRT_DISCORD_SPI_SHARED_SECRET=CHANGE_ME
#
# Keycloak-only: HTTPS URL of the internal backend endpoint, and a PKCS#12 truststore (path +
# password, mounted into the Keycloak container) that trusts the backend's self-signed certificate so
# the HTTPS call validates it. See docs/keycloak/DISCORD_KEYCLOAK_SETUP.md for the keytool steps.
#KRT_BACKEND_PRECHECK_URL=https://backend:11261/internal/discord/account-existence
#KRT_BACKEND_TRUSTSTORE_PATH=/opt/keycloak/conf/backend-truststore.p12
#KRT_BACKEND_TRUSTSTORE_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Transactional e-mail (account approval/rejection notices — REQ-NOTIF-013/-014).
# Ships ENABLED but sends nothing until SPRING_MAIL_HOST is set — with no host,
# mail is a safe no-op. Set the vars below to start sending. Gmail example below:
# needs 2-Step Verification + a 16-char App Password (NOT the account password),
# and the From must be the Gmail address (Gmail rewrites it to the auth'd user).
# Never commit real SMTP credentials.
# ---------------------------------------------------------------------------
#SPRING_MAIL_HOST=smtp.gmail.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=you@gmail.com
#SPRING_MAIL_PASSWORD=CHANGE_ME
# Kill-switch; ships true. Set false to hard-disable regardless of SMTP config.
#APP_MAIL_ENABLED=true
# Envelope sender shown to recipients (use your Gmail address for Gmail).
#APP_MAIL_FROM_ADDRESS=you@gmail.com
#APP_MAIL_FROM_NAME=Profit Basetool

# ---------------------------------------------------------------------------
# Optional: only needed when running backend OUTSIDE docker-compose
# (e.g. ./gradlew :backend:bootRun --args=--spring.profiles.active=dev).
# Inside compose, these are set automatically from POSTGRES_USER/PASSWORD.
# ---------------------------------------------------------------------------
# SPRING_DATASOURCE_USERNAME=CHANGE_ME
# SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Monitoring stack (epic #936, ADR-0072). ALL optional. On a host WITHOUT the
# monitoring stack, leave everything below unset: /actuator/prometheus stays
# fail-closed (denies every request), tracing stays fully inert, and deploy.sh
# does not touch the monitoring project. Full rollout: docs/MONITORING_ROLLOUT_RUNBOOK.md.
# ---------------------------------------------------------------------------
# --- App instrumentation (read by backend/frontend/ingest) ---
# Prometheus scrape basic-auth identity for /actuator/prometheus. The username is
# fixed to "monitoring" in monitoring/prometheus/prometheus.yml; keep them in sync.
# Password >=32 random chars (openssl rand -base64 36). Unset → endpoint denies all.
#MONITORING_SCRAPE_USER=monitoring
#MONITORING_SCRAPE_PASSWORD=CHANGE_ME
# Distributed tracing master gate + OTLP endpoint (Alloy on the scrape net). Unset/false → inert.
#MONITORING_TRACING_ENABLED=true
#MONITORING_OTLP_ENDPOINT=http://alloy:4318/v1/traces
#MONITORING_TRACING_SAMPLING_PROBABILITY=1.0
# --- Keycloak (prod service only) — metrics + user-event metrics + tracing ---
#KC_METRICS_ENABLED=true
#KC_EVENT_METRICS_USER_ENABLED=true
#KC_TRACING_ENABLED=true
#KC_TRACING_ENDPOINT=http://alloy:4317
# --- Redis monitoring ACL file (prod redis mounts it; MUST exist before the deploy) ---
#IRI_REDIS_ACL_HOST_PATH=/var/iri/redis/users.acl
# --- Monitoring stack activation (deploy.sh non-gating apply step) ---
#IRI_MONITORING_ENABLED=true
# --- Grafana (docker-compose.monitoring.yml) ---
#GRAFANA_ROOT_URL=https://grafana.profit-base.online/
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=CHANGE_ME
#GRAFANA_OAUTH_CLIENT_ID=grafana
#GRAFANA_OAUTH_CLIENT_SECRET=CHANGE_ME
# Prometheus web-auth password (Grafana datasource + self-scrape + backup TSDB snapshot).
# The bcrypt of this lives in /var/iri/monitoring/secrets/prometheus-web.yml (runbook).
#PROMETHEUS_WEB_PASSWORD=CHANGE_ME
# --- Exporter DB/Redis users (pg_monitor role / read-only Redis ACL) ---
#PG_EXPORTER_USER=monitoring
#PG_EXPORTER_BACKEND_PASSWORD=CHANGE_ME
#PG_EXPORTER_KEYCLOAK_PASSWORD=CHANGE_ME
#REDIS_EXPORTER_USER=monitoring
#REDIS_EXPORTER_PASSWORD=CHANGE_ME
# --- Alertmanager render (envsubst → /var/iri/monitoring/secrets/alertmanager.yml) + Watchdog ---
# These are consumed by the runbook's envsubst step, not by docker-compose directly.
#SMTP_SMARTHOST=smtp.example.com:587
#SMTP_FROM=alerts@profit-base.online
#SMTP_AUTH_USERNAME=CHANGE_ME
#SMTP_AUTH_PASSWORD=CHANGE_ME
#ALERT_EMAIL_TO=ops@profit-base.online
# healthchecks.io dead-man's-switch ping URL (the always-firing Watchdog is routed here).
#HEARTBEAT_URL=https://hc-ping.com/CHANGE_ME
