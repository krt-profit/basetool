# Copy this file to .env and fill in real values.
# .env must NEVER be committed.
# Generate strong passwords, e.g.:  openssl rand -base64 32
#
# The uncommented entries are the ones every deployment sets; the commented ones are
# optional. A missing required value fails fast: Compose (local/test stacks) refuses
# to start, and on the production host (rootless Podman + Quadlet) the deployer's
# scripts/render-env-d.py refuses to render the per-service env files
# (/var/iri/code/env.d/<service>.env).
#
# Quadlet does not interpolate unit files: every *_HOST_PATH below, IRI_IMAGE_NAMESPACE
# and IRI_KEYCLOAK_HOST_ALIAS are baked into the generated units at their defaults
# (scripts/generate-quadlet.py, PATH_VARS / VALUE_VARS / image defaults). Setting them
# here changes a Compose stack only; a Quadlet host that needs another value supplies
# a systemd drop-in beside the unit.

# Backend Database configuration
POSTGRES_DB=krt_basetool
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# Keycloak Database configuration
KC_POSTGRES_DB=keycloak
KC_POSTGRES_USER=CHANGE_ME
KC_POSTGRES_PASSWORD=CHANGE_ME

# Keycloak Initial Admin User
KC_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# Keycloak admin-API client secret (used by backend to sync users).
# Get / rotate this in the Keycloak admin console:
#   Realm "iri" -> Clients -> backend-service -> Credentials -> Regenerate.
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME

# Optional: cadence of the periodic Keycloak->local user sync. Spring 6-field cron
# (sec min hour dom mon dow) evaluated in APP_KEYCLOAK_SYNC_ZONE. Default: once per
# day at 05:00 Europe/Berlin (off-peak). The sync is a drift-correction safety net,
# not a live feed; admins trigger an immediate refresh from the member-management
# page's "Sync now" button. An invalid cron fails startup.
#APP_KEYCLOAK_SYNC_CRON=0 0 5 * * *
#APP_KEYCLOAK_SYNC_ZONE=Europe/Berlin

# PKCS12 keystore password for backend + frontend Spring SSL.
# The keystore file itself (keystore.p12) is .gitignore'd and must be
# provided out-of-band as a bind mount (see IRI_KEYSTORE_HOST_PATH below) —
# the keystore is NEVER baked into the GHCR image (see CLAUDE.md and the
# .dockerignore at the repo root for the threat model).
SERVER_SSL_KEY_STORE_PASSWORD=CHANGE_ME

# Absolute host path to the production keystore.p12. Bind-mounted read-only
# into both backend and frontend containers at /run/secrets/keystore.p12.
# Owner should be the runtime user (container uid 10001 — on the rootless Podman
# host that is the TRANSLATED host uid, see ansible/README.md "The uid arithmetic")
# or `o+r` so the JVM can read the file. On a production host the canonical location is
# /var/iri/secrets/keystore.p12; for a local dev stack, the default
# (`./keystore.p12`) resolves relative to docker-compose.yml. The isolated test
# stack ignores this variable: docker-compose.test.yml mounts the committed
# throwaway keystore from docker/test-tls/ by a hardcoded path (ADR-0139).
IRI_KEYSTORE_HOST_PATH=/var/iri/secrets/keystore.p12

# Redis password -- the `default` user's until the per-service rollout, and the operator's `admin`
# user's for ever (REQ-SEC-068). The ACL file carries its SHA-256, rendered by
# scripts/render-redis-acl.py; see docs/deployment.md, The Redis ACL.
REDIS_PASSWORD=CHANGE_ME
# One Redis ACL user per service (REQ-SEC-068, ADR-0207). Each app uses its own user only when its
# USERNAME is set; unset, it authenticates as `default` with REDIS_PASSWORD, as before. Generate the
# passwords ON THE HOST (openssl rand -base64 36 | tr -d '/+=\n'); the usernames are fixed by the
# ACL template. REDIS_DEFAULT_USER=off switches `default` off once all three apps have moved.
#REDIS_FRONTEND_USERNAME=basetool-frontend
#REDIS_FRONTEND_PASSWORD=CHANGE_ME
#REDIS_BACKEND_USERNAME=basetool-backend
#REDIS_BACKEND_PASSWORD=CHANGE_ME
#REDIS_INGEST_USERNAME=basetool-ingest
#REDIS_INGEST_PASSWORD=CHANGE_ME
#REDIS_DEFAULT_USER=on

# ---------------------------------------------------------------------------
# Image-pull configuration (consumed by docker-compose.yml; see the Quadlet note at the top)
# ---------------------------------------------------------------------------
# GHCR namespace that owns the basetool-backend / basetool-frontend packages.
# Default `krt-profit` matches the GitHub organisation that publishes the
# production images via .github/workflows/release-images.yml — override only
# when running against a fork's own GHCR namespace.
IRI_IMAGE_NAMESPACE=krt-profit

# Version pointer that resolves to a concrete GHCR tag. The deploy.sh script
# leaves this unset by default so the host follows the rolling `:stable`
# pointer that is updated atomically by .github/workflows/promote.yml.
# Pin to a specific version (`1.4.2`, `sha-abc1234`, ...) to roll back or
# stage an earlier release. Tags are immutable per digest, so a pinned
# version always resolves to the same image.
#IRI_BASETOOL_VERSION=stable

# ---------------------------------------------------------------------------
# Public Keycloak identity (REQ-OPS-022). PRODUCTION LEAVES THIS UNSET.
# ---------------------------------------------------------------------------
# Only a non-production environment that runs the SAME promoted config bundle
# under its own domain needs this — e.g. the PVE testing stack fed by the
# :testing tag. Unset, it falls back to the production value baked into
# docker-compose.yml, so an existing .env keeps behaving exactly as before.
#
# SET THE HOSTNAME; THE ISSUER FOLLOWS. IRI_KEYCLOAK_HOSTNAME is the one source:
# it becomes Keycloak's KC_HOSTNAME, and docker-compose.yml DERIVES from it the
# issuer that backend, frontend and ingest validate (ADR-0167). Until then the
# two were independent values this file told you to keep in agreement by hand —
# "set both or neither" — and a half-set pair failed every request with "issuer
# does not match", which reads like a token problem and was in fact this. It can
# no longer be half-set, and scripts/check-keycloak-issuer.py fails CI if the
# derivation is ever taken back out.
#
# IT ALSO MOVES GRAFANA. docker-compose.monitoring.yml derives its three Keycloak
# OIDC URLs from this same variable, and Grafana's environment is rendered from
# this same .env (Compose: the same --project-directory; Quadlet: render-env-d.py).
# One value, both stacks. The Prometheus probe targets in monitoring/prometheus/prometheus.yml
# are the exception: that file is static and nothing interpolates it, so moving
# the domain means editing those four URLs by hand — the CI gate will tell you.
#
# INCLUDE THE /auth PATH (ADR-0166). Keycloak serves under it
# (KC_HTTP_RELATIVE_PATH in docker-compose.yml), and a full URL here overrides
# the context path it would otherwise take from the request — so an origin-only
# value produces a server that ANSWERS on /auth and ADVERTISES root links. That
# failure is measured and it is silent at the Keycloak end: the container goes
# healthy, and the backend dies at start-up with an issuer mismatch instead.
#IRI_KEYCLOAK_HOSTNAME=https://basetool.greluc.me/auth
#
# The issuer is then https://basetool.greluc.me/auth/realms/iri and the variable
# below needs no value. It stays available as an override for a deployment whose
# advertised issuer genuinely differs from KC_HOSTNAME — and because it wins when
# set, setting it also opts that deployment out of the agreement the gate checks.
#IRI_KEYCLOAK_ISSUER_URI=
#
# Same situation, one layer down: backend, frontend and ingest load the OIDC metadata
# from IRI_KEYCLOAK_ISSUER_URI when they start, so that hostname has to resolve to
# something that answers. Behind a NAT that does not hairpin, the public name resolves
# to the WAN address and the request never comes back — the app then never becomes
# healthy and the deploy health-gate rolls back. Point the name at the host's own
# reverse proxy instead. Compose `extra_hosts` `name:ip` format, one entry.
# Unset it defaults to `localhost:127.0.0.1`, which changes nothing. On a Quadlet
# host this variable is NOT read: the alias is an `AddHost=` line in a systemd
# drop-in beside the unit (scripts/generate-quadlet.py, VALUE_VARS).
# Since ADR-0166 the name to alias is the WEB host, because that is where the issuer
# lives; there is no Keycloak hostname any more.
#IRI_KEYCLOAK_HOST_ALIAS=basetool.greluc.me:10.98.0.11
#
# One layer further: resolving the name is not the same as trusting what answers on it.
# Spring Security fetches the OIDC metadata at startup with a plain RestTemplate, which
# uses the JVM DEFAULT trust store — the `backend-trust` SSL bundle does not cover it.
# Behind a self-signed certificate that fails with "PKIX path building failed", the app
# never reports healthy and the deploy health-gate rolls back.
#
# Build the trust store as a COPY OF THE JVM ANCHORS plus your certificate, never as the
# keystore itself: it then holds no private key, which is why `changeit` is fine here and
# why the keystore password must NOT end up on a command line. Recipe:
#   docker run --rm --user 0 -v /tmp/ts:/out --entrypoint sh eclipse-temurin:25-jre-alpine -c '
#     cp $JAVA_HOME/lib/security/cacerts /out/truststore.p12
#     keytool -importcert -noprompt -alias my-env -file /out/my.crt \
#             -keystore /out/truststore.p12 -storepass changeit'
#IRI_TRUSTSTORE_HOST_PATH=/var/iri/secrets/truststore.p12
#IRI_EXTRA_JAVA_OPTS=-Djavax.net.ssl.trustStore=/run/secrets/truststore.p12 -Djavax.net.ssl.trustStorePassword=changeit -Djavax.net.ssl.trustStoreType=PKCS12

# ---------------------------------------------------------------------------
# Ingest gateway (epic #639 — desktop one-click send). Both optional.
# ---------------------------------------------------------------------------
# Public frontend URL the gateway sends the extractor's browser to
# (…?handoff=<id>). Defaults to https://profit-base.online; set to your
# frontend's public origin (local dev stack: http://localhost:18081).
#IRI_FRONTEND_PUBLIC_URL=https://profit-base.online
#
# JWT audience enforcement (security review, audit L-1). Empty/unset = OFF, so
# the backend and ingest accept any validly-signed token from the realm.
#
# THE TWO VARS TAKE DIFFERENT VALUES — this is not a copy-paste pair.
#
# The BACKEND takes basetool-backend. The realm's `extractor-ingest` client
# scope (a default scope on both the basetool-frontend and basetool-sc-extractor
# clients, see docs/keycloak/realm-config.reference.json) stamps it, so every
# token the backend receives should already carry it.
#
# The GATEWAY takes basetool-ingest, NOT basetool-backend (ADR-0018 amendment 1,
# REQ-INGEST-011). Every frontend session token carries basetool-backend, so
# pointing the gateway at it makes the check pass for exactly the tokens this
# interface exists to refuse. basetool-ingest is stamped by the separate
# `extractor-ingest-only` scope, which only basetool-sc-extractor carries.
#
# Enable either ONLY after confirming a real access token's `aud` carries the
# value on the deployed realm; enabling it earlier rejects every token and
# breaks the app. Unsetting the GATEWAY's var disables its check instantly; the
# backend's var cannot be unset on a prod host any more (see below).
# Runbook: docs/INGEST_KEYCLOAK_SETUP.md step 7a (gateway), step 6 (backend).
#
# The MECHANISM no longer needs a prod first-run to be trusted: the E2E stack
# runs the backend with enforcement ON against a realm that stamps the audience,
# so the enforced decoder + aud validator are exercised end to end on every
# e2e-labelled PR. What the E2E run cannot tell you is whether the DEPLOYED
# realm stamps it — that is the one check left before flipping these on, and
# it is a read-only Keycloak query (INGEST_KEYCLOAK_SETUP.md step 5), not a
# token paste into a third-party decoder.
#
# IRI_BACKEND_EXPECTED_AUDIENCES is REQUIRED on a production host since 2026-09-22 (APPSEC-08):
# the backend refuses to start under the prod profile while it is blank. It is enforcing in
# production since 2026-08-28. Left commented here because a dev or test stack
# (dev profile, hand-rolled realm) must not inherit it. The ingest gateway's
# value stays optional.
#IRI_BACKEND_EXPECTED_AUDIENCES=basetool-backend
#IRI_INGEST_EXPECTED_AUDIENCES=basetool-ingest
#
# --- Client-identity gate (REQ-INGEST-011) ---------------------------------
# THE INGEST INTERFACE IS RESTRICTED TO CLIENTS APPROVED BY THE BASETOOL
# DEVELOPER (@greluc). Approving a client = a dedicated Keycloak client
# registration AND an entry in the allowlist below. Two independent gates;
# removing the allowlist entry revokes a client within one access-token
# lifespan, without a Keycloak change or a release.
#
# Every value below is EMPTY by default, which makes each check INERT. That is
# deliberate: the Keycloak-side mappers/scopes are an operator step, so shipping
# these pre-enabled would reject every real extractor token on deploy.
# Configure -> run with AUDIT_ONLY=true -> watch
# basetool_ingest_client_rejected_total stay at zero -> then enforce.
# Runbook: docs/INGEST_KEYCLOAK_SETUP.md step 7.
#
# Keycloak client ids (azp) allowed to call /v1/**. Comma-separated; several at
# once make a client-id rotation possible without downtime.
#IRI_INGEST_ALLOWED_CLIENT_IDS=basetool-sc-extractor

# --- Ingest gateway as a trusted subsystem (ADR-0129, runbook step 9) --------------------------
# The gateway validates the extractor's DPoP proof itself and calls the backend under its OWN
# identity. All four are required together; each is fail-closed on its own.
#
# The gateway's public origin, used only as the DPoP `htu` target. WITHOUT THIS the comparison falls
# back to a URL derived from the reverse proxy's forwarded headers, which is exactly the mismatch
# that fails only in production.
#IRI_INGEST_PUBLIC_BASE_URL=https://ingest.profit-base.online
# The gateway's confidential client (service account). The secret is a credential that lets the
# gateway act for ANY member — treat it like the database password.
#IRI_INGEST_SERVICE_ACCOUNT_TOKEN_URI=https://profit-base.online/auth/realms/iri/protocol/openid-connect/token
#IRI_INGEST_SERVICE_ACCOUNT_CLIENT_ID=basetool-ingest-gateway
#IRI_INGEST_SERVICE_ACCOUNT_CLIENT_SECRET=
# The same client id, on the BACKEND, as the only azp allowed to send X-Ingest-On-Behalf-Of.
#IRI_INGEST_GATEWAY_CLIENT_IDS=basetool-ingest-gateway
#
# OAuth scope an ingest token must carry. MUST be a scope the extractor has,
# the FRONTEND does not, and that is emitted into the `scope` claim. The shipped
# `extractor-ingest` scope fails BOTH: it is a default scope on both clients AND
# it carries include.in.token.scope=false, so setting it here would reject every
# caller including the real extractor (see runbook 7a).
#IRI_INGEST_REQUIRED_SCOPE=extractor-ingest-only
#
# Accepted payload `tool` provenance. Client-supplied and therefore forgeable —
# telemetry with a reject attached, never authentication.
#
# BOTH values are required: the extractor emits a DIFFERENT `tool` string per
# export path — `basetool-sc-extractor` on the refinery path, but the display
# name `Basetool SC Extractor` on the blueprint path. Listing only the slug
# rejects every blueprint send with 403 CLIENT_NOT_ALLOWED (incident 2026-08-03).
# The comparison folds case, so casing drift alone is tolerated; these two differ
# structurally and must both be listed.
#IRI_INGEST_ALLOWED_TOOLS=basetool-sc-extractor,Basetool SC Extractor
#
# true = run every configured check but never reject (log + count only).
#IRI_INGEST_CLIENT_AUDIT_ONLY=false

# ---------------------------------------------------------------------------
# Discord login (epic #720) — optional nickname capture for the approval queue
# ---------------------------------------------------------------------------
# The das-kartell Discord guild (server) id. When set, the Keycloak Discord SPI
# captures each member's per-guild server nickname and shows it in the admin
# registration-approval queue (REQ-DATA-018). Leave UNSET to disable nickname
# capture (fail-open — it never affects the login). Surfacing it also needs the
# two Keycloak mappers from docs/keycloak/DISCORD_KEYCLOAK_SETUP.md §3c.
# Discord client -> Developer Mode -> right-click the server -> Copy Server ID.
#DISCORD_GUILD_ID=

# Discord first-login account-existence precheck (REQ-SEC-022, ADR-0051). When set, a brand-new
# Discord first-login whose username / server nickname / e-mail already matches an existing account
# is denied with a localized "link your existing account instead" page, preventing duplicate
# accounts. Entirely fail-open: leave the values UNSET to disable the precheck (login behaves as
# before). HTTPS ONLY — never plain HTTP.
#
# Shared secret, set to the SAME value on BOTH the backend (guards /internal/discord/account-existence)
# and the Keycloak SPI (presents it in the X-KRT-SPI-Secret header). Generate a long random value.
#KRT_DISCORD_SPI_SHARED_SECRET=CHANGE_ME
#
# Keycloak-only: HTTPS URL of the internal backend endpoint, and a PKCS#12 truststore (path +
# password, mounted into the Keycloak container) that trusts the backend's self-signed certificate so
# the HTTPS call validates it. See docs/keycloak/DISCORD_KEYCLOAK_SETUP.md for the keytool steps.
#KRT_BACKEND_PRECHECK_URL=https://backend:11261/internal/discord/account-existence
#KRT_BACKEND_TRUSTSTORE_PATH=/opt/keycloak/conf/backend-truststore.p12
#KRT_BACKEND_TRUSTSTORE_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Transactional e-mail (account approval/rejection notices — REQ-NOTIF-013/-014).
# Ships ENABLED but sends nothing until SPRING_MAIL_HOST is set — with no host,
# mail is a safe no-op. Set the vars below to start sending. Gmail example below:
# needs 2-Step Verification + a 16-char App Password (NOT the account password),
# and the From must be the Gmail address (Gmail rewrites it to the auth'd user).
# Never commit real SMTP credentials.
# ---------------------------------------------------------------------------
#SPRING_MAIL_HOST=smtp.gmail.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=you@gmail.com
#SPRING_MAIL_PASSWORD=CHANGE_ME
# Kill-switch; ships true. Set false to hard-disable regardless of SMTP config.
#APP_MAIL_ENABLED=true
# Envelope sender shown to recipients (use your Gmail address for Gmail).
#APP_MAIL_FROM_ADDRESS=you@gmail.com
#APP_MAIL_FROM_NAME=Profit Basetool

# ---------------------------------------------------------------------------
# Optional: only needed when running backend OUTSIDE docker-compose
# (e.g. ./gradlew :backend:bootRun --args=--spring.profiles.active=dev).
# Inside compose, these are set automatically from POSTGRES_USER/PASSWORD.
# ---------------------------------------------------------------------------
# SPRING_DATASOURCE_USERNAME=CHANGE_ME
# SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Monitoring stack (epic #936, ADR-0072). ALL optional. On a host WITHOUT the
# monitoring stack, leave everything below unset: /actuator/prometheus stays
# fail-closed (denies every request), tracing stays fully inert, and deploy.sh
# skips its monitoring reconcile/reload step (IRI_MONITORING_ENABLED). Current
# operations: docs/deployment.md; the historical rollout:
# docs/archive/MONITORING_ROLLOUT_RUNBOOK.md.
# ---------------------------------------------------------------------------
# --- App instrumentation (read by backend/frontend/ingest) ---
# Prometheus scrape basic-auth identity for /actuator/prometheus. The username is
# fixed to "monitoring" in monitoring/prometheus/prometheus.yml; keep them in sync.
# Password >=32 random chars (openssl rand -base64 36). Unset → endpoint denies all.
#MONITORING_SCRAPE_USER=monitoring
#MONITORING_SCRAPE_PASSWORD=CHANGE_ME
# Distributed tracing master gate + OTLP endpoint (Alloy on the scrape net). Unset/false → inert.
#MONITORING_TRACING_ENABLED=true
#MONITORING_OTLP_ENDPOINT=http://alloy:4318/v1/traces
#MONITORING_TRACING_SAMPLING_PROBABILITY=1.0
# --- Keycloak (prod service only) — metrics + user-event metrics + tracing ---
#KC_METRICS_ENABLED=true
#KC_EVENT_METRICS_USER_ENABLED=true
#KC_TRACING_ENABLED=true
#KC_TRACING_ENDPOINT=http://alloy:4317
# --- Redis monitoring ACL file (prod redis mounts it; MUST exist before the deploy) ---
#IRI_REDIS_ACL_HOST_PATH=/var/iri/redis/users.acl
# --- Monitoring stack activation (deploy.sh non-gating apply step) ---
#IRI_MONITORING_ENABLED=true
# --- Grafana (docker-compose.monitoring.yml) ---
#GRAFANA_ROOT_URL=https://grafana.profit-base.online/
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=CHANGE_ME
#GRAFANA_OAUTH_CLIENT_ID=grafana
#GRAFANA_OAUTH_CLIENT_SECRET=CHANGE_ME
# Prometheus web-auth password (Grafana datasource + self-scrape + backup TSDB snapshot).
# The bcrypt of this lives in /var/iri/monitoring/secrets/prometheus-web.yml (runbook).
#PROMETHEUS_WEB_PASSWORD=CHANGE_ME
# --- Exporter DB/Redis users (pg_monitor role / read-only Redis ACL) ---
#PG_EXPORTER_USER=monitoring
#PG_EXPORTER_BACKEND_PASSWORD=CHANGE_ME
#PG_EXPORTER_KEYCLOAK_PASSWORD=CHANGE_ME
#REDIS_EXPORTER_USER=monitoring
#REDIS_EXPORTER_PASSWORD=CHANGE_ME
# --- Alertmanager render (envsubst → /var/iri/monitoring/secrets/alertmanager.yml) + Watchdog ---
# These fill monitoring/alertmanager/alertmanager.yml.tmpl through an envsubst step on
# the host (monitoring/README.md), not the compose/Quadlet environment directly.
#SMTP_SMARTHOST=smtp.example.com:587
#SMTP_FROM=alerts@profit-base.online
#SMTP_AUTH_USERNAME=CHANGE_ME
#SMTP_AUTH_PASSWORD=CHANGE_ME
#ALERT_EMAIL_TO=ops@profit-base.online
# healthchecks.io dead-man's-switch ping URL (the always-firing Watchdog is routed here).
#HEARTBEAT_URL=https://hc-ping.com/CHANGE_ME

# ---------------------------------------------------------------------------
# Optional knobs — compose already defaults every one of these, so the stack
# starts without them. Listed because an operator has no other way to learn
# they exist: they appear in docker-compose.yml and nowhere a reader looks.
# ---------------------------------------------------------------------------
# --- Android app version policy (served by GET /api/v1/app/version-policy) ---
# MINIMUM is a WALL: a build below it shows „Update erforderlich" and cannot be used. It defaults
# to 0 = NO FLOOR on purpose — a non-zero default would lock every member out of the first
# environment nobody has configured yet, and serving an old build for one more day is the cheap
# direction of a wrong guess. Raise it only when a contract change actually breaks an old build,
# and only to a versionCode that has been released.
# LATEST is the other half and does not gate anything: it means „a newer build exists". Keep the
# two apart, or every release reads as a forced one.
#APP_ANDROID_MINIMUM_VERSION_CODE=0
#APP_ANDROID_LATEST_VERSION_CODE=0
#APP_ANDROID_RELEASES_URL=https://github.com/krt-profit/basetool-android/releases/latest
# --- Live-update fan-out kill switches ---
# Set either to false to fall back to single-instance behaviour without a redeploy.
#APP_LIVE_SYNC_REDIS_FANOUT_ENABLED=true
#APP_NOTIFICATIONS_REDIS_FANOUT_ENABLED=true
# --- Slow-request WARN threshold (all three modules) ---
# Access-log lines above this are escalated to WARN. Raise it on a host whose baseline is slower
# than the default, or the WARNs stop meaning anything.
#APP_LOGGING_SLOW_REQUEST_THRESHOLD_MS=2000
# --- Data-export download timeout (REQ-SEC-058) ---
# The one frontend->backend call expected to take a long time: an Art. 15 export runs ~29
# statements across the whole schema and then renders a PDF. The shared app.http.response-timeout
# (5s) turned a working export into a 500 for a member with years of history, so this call carries
# its own bound. Raise it if an export still times out; every other call keeps the 5s.
#APP_HTTP_EXPORT_RESPONSE_TIMEOUT=120s
# --- Session type allow-list (REQ-SEC-067) ---
# Which classes a session value stored in Redis may name as its type. report (default) reads
# everything as before and counts a class outside the list in basetool_session_type_refused_total;
# enforce refuses such a class (that one attribute is dropped); off restores the old permissive
# validator. Switch to enforce only after the report counter has stayed at zero.
#APP_SESSION_TYPE_ALLOW_LIST=report
# --- Clients with a deliberately incomplete role scope (REQ-SEC-036) ---
# A login through one of these must not overwrite the member's stored roles, because its token
# does not carry them all. Comma-separated; the Android app is the only such client today, and an
# empty value means "no client is exempt" -- which would let an app login shrink an admin's roles.
#APP_SECURITY_PARTIAL_ROLE_SCOPE_CLIENT_IDS=basetool-android
# --- Per-account export budget (REQ-SEC-033 carve-out, APPSEC-10) ---
# Every /api/** export, statement, report and PDF endpoint spends from a separate per-account
# bucket: CAPACITY requests (also the refill amount) per REFILL_PERIOD. Capacity below 1 refuses
# to start. Defaults: 10 per minute.
#APP_RATE_LIMIT_SUBJECT_EXPORT_CAPACITY=10
#APP_RATE_LIMIT_SUBJECT_EXPORT_REFILL_PERIOD=1m
# --- Retention sweeps: READ THIS BEFORE THE FIRST DEPLOY OF A RELEASE THAT ADDS ONE ---
# Three scheduled jobs delete rows past a retention window (REQ-AUDIT-006, REQ-SEC-057,
# REQ-NOTIF-009). They are ON by default, and the FIRST run after a sweep first ships removes
# everything already past its window in one irreversible pass. If that history must be kept, set
# the matching *_ENABLED=false HERE, before deploying -- there is no undo afterwards. The audit
# trail can be exported first instead (REQ-AUDIT-003).
# Each MAX_AGE has a floor the backend enforces at startup (since 2026-09-22, BE-MOD-03): a value
# below it -- P0D or a negative one would purge everything -- refuses to start instead of deleting.
# Audit/bank >= P30D, rejected registrations >= P1D, notifications >= P1D for both windows with
# UNREAD_MAX_AGE never shorter than MAX_AGE; every INTERVAL >= PT1M.
# Audit + bank trails, 730 days (two years). ADR-0179.
#APP_AUDIT_RETENTION_ENABLED=true
#APP_AUDIT_RETENTION_MAX_AGE=P730D
#APP_AUDIT_RETENTION_INTERVAL=PT24H
# Rejected registrations, 90 days. MAX_AGE is also the window in which an erroneous rejection can
# still be reopened (REQ-SEC-034), so shortening it shortens the recovery window too.
#APP_REGISTRATIONS_REJECTED_RETENTION_ENABLED=true
#APP_REGISTRATIONS_REJECTED_RETENTION_MAX_AGE=P90D
#APP_REGISTRATIONS_REJECTED_RETENTION_INTERVAL=PT24H
# Notifications: read ones age 90 days from readAt, unread ones 180 days from createdAt.
#APP_NOTIFICATIONS_RETENTION_ENABLED=true
#APP_NOTIFICATIONS_RETENTION_MAX_AGE=P90D
#APP_NOTIFICATIONS_RETENTION_UNREAD_MAX_AGE=P180D
#APP_NOTIFICATIONS_RETENTION_INTERVAL=PT24H
# --- Ingest hand-off window ---
#IRI_INGEST_HANDOFF_TTL=PT30M
# --- Ingest per-IP rate limit (REQ-INGEST-005) ---
# The per-IP bucket is deliberately looser than the per-member one (30/min): several members can
# share one public address behind a CGNAT or an office NAT. Requests per refill period (1 minute).
#IRI_INGEST_RATE_LIMIT_IP_CAPACITY=120
#IRI_INGEST_RATE_LIMIT_IP_REFILL_TOKENS=120
# --- Keycloak user-event metrics (cardinality knobs; an unknown event name refuses startup) ---
#KC_EVENT_METRICS_USER_EVENTS=login,logout,register,code_to_token,refresh_token,identity_provider_login,identity_provider_first_login,identity_provider_post_login
#KC_EVENT_METRICS_USER_TAGS=realm,idp
#
# Deliberately NOT listed above, though compose reads them: REDIS_HOST, REDIS_PORT and
# SPRING_PROFILES_ACTIVE. The compose network and the prod profile pin all three, so overriding
# one in .env does not tune the stack — it breaks it.

# --- Edge vhosts (ADR-0162) --------------------------------------------------
# The host name each edge vhost answers to. nginx has no variables in
# `server_name` and one promoted bundle serves every environment, so these are
# substituted into the vhost templates when the container starts. The
# certificate directory is derived from the same name, /etc/nginx/certs/<host>/.
# No defaults: an unset one would render `server_name ;`, and the edge refuses to
# start rather than serve a half-configured vhost.
EDGE_HOST_FRONTEND=profit-base.online
EDGE_HOST_INGEST=ingest.profit-base.online
EDGE_HOST_GRAFANA=grafana.profit-base.online
EDGE_HOST_API=api.profit-base.online

# The addresses the edge accepts a PROXY-protocol header from (ADR-0187): the
# edge's OWN pinned address on each of its six networks, space-separated, because
# rootless port forwarding presents the host haproxy's connection from whichever
# of them podman picks. Must equal the `ip=` pins in quadlet/systemd/edge.container
# and `basetool_host_edge_trusted_proxies` in the Ansible role (the generator
# refuses a mismatch). Literal addresses only — render-and-run.sh refuses a prefix
# or a wildcard. Setting it switches every edge listener to `proxy_protocol`;
# EMPTY means no front end (plain listeners), which only fits a stack with nothing
# in front of the edge. Wrong or incomplete, nginx discards the header and the
# whole internet shares one rate-limit bucket (docs/deployment.md → The edge).
EDGE_TRUSTED_PROXY=172.28.15.10 172.28.3.250 172.28.4.250 172.28.7.250 172.28.11.250 172.28.13.250
# Extra addresses allowed onto /auth/admin besides the host loopback the SSH
# tunnel arrives as — a jump host, a VPN endpoint. Space-separated literal
# addresses, never a prefix (the edge refuses to start on one). Empty by default.
#EDGE_ADMIN_ALLOW=

# Hosts `acme` obtains ONE multi-SAN certificate for; the first becomes the CN.
# EMPTY is valid and meaningful: an environment whose certificate is provided
# rather than issued — a test host behind a proxy, where HTTP-01 cannot reach
# anything — leaves this unset and the acme container idles.
ACME_HOSTS=profit-base.online ingest.profit-base.online grafana.profit-base.online api.profit-base.online
# The Let's Encrypt account contact. Required whenever ACME_HOSTS is non-empty:
# the acme container exits with "ACME_EMAIL must be set" otherwise
# (docker/acme/publish-loop.sh). Unused while ACME_HOSTS is empty.
ACME_EMAIL=CHANGE_ME
