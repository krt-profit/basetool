# keycloak-spi logs through JBOSS LOGGING, not SLF4J -- and this file is the one place that says so.
#
# The provider JAR is loaded by the Keycloak (Quarkus) JVM, not ours. `org.jboss.logging.Logger` is
# the API the Keycloak SPI classes themselves use, so it cannot go missing while this module still
# compiles. SLF4J *would* work today -- `org.jboss.slf4j:slf4j-jboss-logmanager` is on the
# classpath -- but it arrives transitively through `quarkus-opentelemetry`, an optional Quarkus
# feature module, and an SLF4J call with no binding does not fail: it prints one line to stderr at
# startup and then silently discards every log statement. This module's logs are the only diagnosis
# for a fail-closed login gate refusing everybody, so "silently discards" is the one failure mode
# it must not have. See ADR-0192.
#
# Settings not named here still come from the repository root's lombok.config; this file only
# inverts the logging rule for this module.
lombok.log.jbosslog.flagUsage = ALLOW
lombok.log.slf4j.flagUsage = ERROR
