# Lombok configuration — applies to EVERY module in this repository (backend, frontend, ingest,
# keycloak-spi, test-support) and to every source set in them (main, test, and the frontend's
# e2e). It used to say "both backend and frontend", which was true when only those two ran
# lombok; it is a single root file that `config.stopBubbling` anchors here, so it was never
# scoped to them.
# https://projectlombok.org/features/configuration
#
# Treat this file as the root of the Lombok config; do not search higher.
config.stopBubbling = true

# Add @lombok.Generated to every Lombok-generated method/constructor/type so
# coverage tools (JaCoCo) and static analysers (SpotBugs, Checkstyle) can
# exclude them. JaCoCo 0.8.2+ honours any annotation named "Generated" with
# class-or-runtime retention automatically; @lombok.Generated is runtime.
#
# This removes the per-line / per-branch coverage noise from getters, setters,
# @Builder boilerplate, toString/equals/hashCode and @RequiredArgsConstructor
# — none of which carry real business logic.
lombok.addLombokGeneratedAnnotation = true

# Annotate the code lombok generates with the project's nullity annotations
# (CLAUDE.md `Java conventions`: JetBrains annotations wherever they communicate a real contract).
#
# Lombok already COPIES `@NotNull` / `@Nullable` / `@UnknownNullability` from a field onto the
# accessors it derives from it -- `org.jetbrains.annotations.*` is in its hardcoded
# BASE_COPYABLE_ANNOTATIONS list, so that half needs no configuration. What it does NOT do by
# default is annotate the members whose nullity comes from lombok itself rather than from our
# source. Setting this to `jetbrains` closes that half, and only that half:
#
#   - `toString()`                              -> @NotNull
#   - `equals(@Nullable Object other)`
#   - `builder()` / `build()` / `toBuilder()`   -> @NotNull
#   - a generated static factory (`of(...)`)    -> @NotNull
#   - a chaining `@Accessors` setter returning `this`, `@With` / `@WithBy`
#   - `@Builder.Singular`'s plural adder, whose collection parameter lombok null-checks anyway
#
# Every one of those is a fact about generated code, not a claim about ours, which is why this is
# safe to switch on repo-wide: lombok emits the annotation only where it already knows the answer.
#
# `jetbrains` maps to org.jetbrains.annotations.NotNull / .Nullable as DECLARATION annotations
# (lombok's NullAnnotationLibrary.JETBRAINS is constructed with typeUse = false), so nothing here
# becomes a TYPE_USE annotation. Both are CLASS-retention, so this adds no runtime dependency --
# but the annotations must be on the COMPILE classpath of every source set that runs lombok, which
# is why each module now declares them for `main`, `test` and (frontend) `e2e`.
#
# Verified against lombok 1.18.46 -- the version Spring Boot 4.1.1 manages and keycloak-spi pins --
# in ConfigurationKeys.ADD_NULL_ANNOTATIONS and its call sites in Handle{ToString,EqualsAndHashCode,
# Builder,SuperBuilder,Constructor,Setter,With,WithBy} and JavacSingularsRecipes.
lombok.addNullAnnotations = jetbrains
