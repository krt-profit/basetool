# npm settings for the frontend lint toolchain (CI-SEC-18).
#
# No package's install-time lifecycle script (preinstall / install / postinstall) runs: the lint
# tools (ESLint, Stylelint, HTMLHint, Prettier, TypeScript) need none, and a compromised transitive
# dependency's postinstall is the classic npm supply-chain entry point. Gradle's npmInstall runs
# `npm ci` against the committed lockfile (frontend/build.gradle.kts).
ignore-scripts=true
