server {
  listen 8443 ssl ${EDGE_LISTEN_OPTS};
  listen [::]:8443 ssl ${EDGE_LISTEN_OPTS};
  http2 on;
  server_name ${EDGE_HOST_FRONTEND};

  ssl_certificate     /etc/nginx/certs/${EDGE_HOST_FRONTEND}/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/${EDGE_HOST_FRONTEND}/privkey.pem;
  include /etc/nginx/edge/include/ssl.conf;

  add_header Strict-Transport-Security $hsts_header always;

  include /etc/nginx/edge/include/hardening.conf;
  include /etc/nginx/edge/include/limits.conf;
  include /etc/nginx/edge/include/maintenance.conf;

  location /actuator { return 404; }

  location ^~ /auth/admin {
    allow 172.28.15.1;
    allow fd00:28:15::1;
    allow 172.28.3.1;
    allow 172.28.4.1;
    allow 172.28.7.1;
    allow 172.28.13.1;${EDGE_ADMIN_ALLOW_EXTRA}
    deny all;

    include /etc/nginx/edge/include/upstream-keycloak.conf;
  }

  location ^~ /auth/health  { return 404; }
  location ^~ /auth/metrics { return 404; }

  location ^~ /auth/realms/iri/protocol/openid-connect/token {
    limit_req        zone=krt_req_perip burst=10 nodelay;
    limit_req_status 429;

    include /etc/nginx/edge/include/upstream-keycloak.conf;
  }

  location = /auth {
    include /etc/nginx/edge/include/upstream-keycloak.conf;
  }

  location /auth/ {
    include /etc/nginx/edge/include/upstream-keycloak.conf;
  }

  location / {
    include /etc/nginx/edge/include/proxy.conf;
    include /etc/nginx/edge/include/upstream-tls.conf;
    proxy_ssl_name                frontend;
    set $upstream_host frontend;
    proxy_pass https://$upstream_host:18081$request_uri;
  }
}
