server {
  listen 127.0.0.1:8081;
  listen [::1]:8081;
  server_name _;

  location = /healthz {
    allow 127.0.0.1;
    allow ::1;
    deny all;
    access_log off;
    add_header Content-Type text/plain always;
    return 200 "ok\n";
  }

  location / { return 444; }
}

server {
  listen 8080 default_server ${EDGE_LISTEN_OPTS};
  listen [::]:8080 default_server ${EDGE_LISTEN_OPTS};
  server_name _;

  include /etc/nginx/edge/include/acme-challenge.conf;

  location / {
    return 308 https://$host$request_uri;
  }
}

server {
  listen 8443 ssl default_server ${EDGE_LISTEN_OPTS};
  listen [::]:8443 ssl default_server ${EDGE_LISTEN_OPTS};
  server_name _;

  ssl_reject_handshake on;

  access_log off;
  return 444;
}
