# Keycloak. The admin console is reachable only through the SSH tunnel, which
# arrives via a docker bridge gateway — see the allow list below.
server {
  listen 8443 ssl;
  listen [::]:8443 ssl;
  http2 on;
  server_name ${EDGE_HOST_KEYCLOAK};

  ssl_certificate     /etc/nginx/certs/${EDGE_HOST_KEYCLOAK}/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/${EDGE_HOST_KEYCLOAK}/privkey.pem;
  include /etc/nginx/edge/include/ssl.conf;

  add_header Strict-Transport-Security $hsts_header always;

  include /etc/nginx/edge/include/hardening.conf;
  include /etc/nginx/edge/include/limits.conf;
  include /etc/nginx/edge/include/maintenance.conf;

  # --- Admin console -------------------------------------------------------
  # The ACL matches $remote_addr, which is the TCP peer. Traffic tunnelled from
  # the host reaches the edge through docker-proxy, so its peer address is the
  # bridge gateway, not the operator's address. That is why gateways are the
  # allow list, and why the deny has to be asserted from a GitHub runner
  # rather than the internal blackbox exporter: a probe that shares the
  # subject's network position cannot test a network-position rule.
  #
  # WHICH gateway is not a free choice: it is the one the published :443 DNATs
  # over. Since the five net-proxy-* bridges became `internal: true` that is
  # net-edge-ingress and nothing else, so the four upstream gateways are kept
  # for an in-container caller while the operator's tunnel arrives on
  # 172.28.15.1. Adding the ingress bridge without adding it here locked the
  # console out completely — every tunnelled request answered 403, which reads
  # as a broken tunnel and is not one.
  #
  # Both families of the dual-stack ingress bridge are listed. A tunnel written
  # `-L 443:localhost:443` resolves to ::1 on a dual-stack host and then arrives
  # on fd00:28:15::1; one word of difference in the ssh command must not decide
  # whether the console opens.
  #
  # `deny all;` is load-bearing. nginx's access module denies nothing
  # implicitly — an `allow` list without the closing `deny all` reads as a
  # lockdown and is open to the internet. The 2026-07-03 audit found exactly
  # that on this location.
  location /admin {
    allow 172.28.15.1;   # net-edge-ingress gateway — where the SSH tunnel arrives
    allow fd00:28:15::1; # net-edge-ingress gateway, IPv6
    allow 172.28.3.1;    # net-proxy-frontend gateway
    allow 172.28.4.1;    # net-proxy-keycloak gateway
    allow 172.28.7.1;    # net-proxy-ingest gateway
    allow 172.28.13.1;   # net-proxy-api gateway
    deny all;

    include /etc/nginx/edge/include/proxy.conf;
    proxy_ssl_verify              on;
    proxy_ssl_verify_depth        2;
    proxy_ssl_trusted_certificate /etc/nginx/upstream-ca.crt;
    proxy_ssl_server_name         on;
    proxy_ssl_name                keycloak;
    # A VARIABLE upstream, not a literal one. With a literal name nginx resolves it
    # once at startup and caches the address forever, so a recreated container
    # leaves the edge pointing at an address nobody answers on until the edge is
    # restarted too. The variable form defers resolution to the resolver declared
    # in nginx.conf and re-resolves on its TTL. $request_uri is appended because a
    # proxy_pass carrying variables does not forward the request URI on its own; it
    # is the RAW, still-encoded form, which is what the upstreams have always been
    # given and what the allow-list deliberately does NOT match on.
    set $upstream_host keycloak;
    proxy_pass https://$upstream_host:18443$request_uri;
  }

  # The legacy /auth/* prefix, Keycloak's own health and metrics: no caller on
  # the public side, so they are closed outright rather than allow-listed.
  location /auth/admin { deny all; }
  location /health     { deny all; }
  location /metrics    { deny all; }

  # The token endpoint gets a tighter burst than the site-wide limiter: it is
  # the one anonymous POST that is worth brute-forcing.
  location /realms/iri/protocol/openid-connect/token {
    limit_req        zone=krt_req_perip burst=10 nodelay;
    limit_req_status 429;

    include /etc/nginx/edge/include/proxy.conf;
    proxy_ssl_verify              on;
    proxy_ssl_verify_depth        2;
    proxy_ssl_trusted_certificate /etc/nginx/upstream-ca.crt;
    proxy_ssl_server_name         on;
    proxy_ssl_name                keycloak;
    # A VARIABLE upstream, not a literal one. With a literal name nginx resolves it
    # once at startup and caches the address forever, so a recreated container
    # leaves the edge pointing at an address nobody answers on until the edge is
    # restarted too. The variable form defers resolution to the resolver declared
    # in nginx.conf and re-resolves on its TTL. $request_uri is appended because a
    # proxy_pass carrying variables does not forward the request URI on its own; it
    # is the RAW, still-encoded form, which is what the upstreams have always been
    # given and what the allow-list deliberately does NOT match on.
    set $upstream_host keycloak;
    proxy_pass https://$upstream_host:18443$request_uri;
  }

  location / {
    include /etc/nginx/edge/include/proxy.conf;
    proxy_ssl_verify              on;
    proxy_ssl_verify_depth        2;
    proxy_ssl_trusted_certificate /etc/nginx/upstream-ca.crt;
    proxy_ssl_server_name         on;
    proxy_ssl_name                keycloak;
    # A VARIABLE upstream, not a literal one. With a literal name nginx resolves it
    # once at startup and caches the address forever, so a recreated container
    # leaves the edge pointing at an address nobody answers on until the edge is
    # restarted too. The variable form defers resolution to the resolver declared
    # in nginx.conf and re-resolves on its TTL. $request_uri is appended because a
    # proxy_pass carrying variables does not forward the request URI on its own; it
    # is the RAW, still-encoded form, which is what the upstreams have always been
    # given and what the allow-list deliberately does NOT match on.
    set $upstream_host keycloak;
    proxy_pass https://$upstream_host:18443$request_uri;
  }
}
