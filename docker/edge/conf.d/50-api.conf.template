# =============================================================================
# The API vhost — default-deny (ADR-0135, ADR-0162)
#
# This host exists so the Android app can reach the backend without the whole
# API becoming internet-reachable. It admits a named allow-list and answers 404
# for everything else; the list itself is include/api-allowlist.conf, carried
# across from the runbook block after both copies were verified identical.
# =============================================================================
server {
  listen 8443 ssl ${EDGE_LISTEN_OPTS};
  listen [::]:8443 ssl ${EDGE_LISTEN_OPTS};
  http2 on;
  server_name ${EDGE_HOST_API};

  ssl_certificate     /etc/nginx/certs/${EDGE_HOST_API}/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/${EDGE_HOST_API}/privkey.pem;
  include /etc/nginx/edge/include/ssl.conf;

  add_header Strict-Transport-Security $hsts_header always;

  include /etc/nginx/edge/include/hardening.conf;
  include /etc/nginx/edge/include/limits.conf;
  include /etc/nginx/edge/include/maintenance.conf;

  include /etc/nginx/edge/include/api-allowlist.conf;

  location / {
    include /etc/nginx/edge/include/proxy-common.conf;
    # --- Forwarded headers: OVERWRITE, never append --------------------------
    # REQ-SEC-011: the backend walks the X-Forwarded-For chain right-to-left and
    # trusts only the pinned compose range. The inherited default is
    # $proxy_add_x_forwarded_for, which APPENDS whatever the client sent, so a
    # client-supplied chain would survive into the value the backend parses.
    # Overwriting with the real peer leaves exactly one element.
    #
    # These sit HERE, inside `location /`, and that placement is half the fix. In
    # the NPM configuration they were at server level while `location /` defined
    # its own proxy_set_header set through proxy.conf — and nginx inherits
    # proxy_set_header from an outer level ONLY when the current level defines
    # none. So the overwrite never took effect in production, and the chain the
    # backend parsed was the appending one this comment was written to prevent.
    #
    # The other half is the include being proxy-COMMON.conf. Moving the directive
    # into this level fixed the INHERITANCE problem and left a second one that
    # reads the same way: proxy.conf's appending `X-Forwarded-For` was set at THIS
    # level too, and two proxy_set_header directives for one name at one level do
    # not replace each other — both headers are sent, appending first. Measured
    # against nginx 1.29 with an echo upstream: `X-Forwarded-For: 8.8.8.8` arrived
    # as `8.8.8.8, <edge>, <edge>`, so a right-to-left walk that trusts the edge
    # range still resolved the client to 8.8.8.8 and REQ-SEC-011 was not met.
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  443;
    proxy_set_header Forwarded         "";
    include /etc/nginx/edge/include/upstream-tls.conf;
    proxy_ssl_name                backend;
    # A VARIABLE upstream, not a literal one. With a literal name nginx resolves it
    # once at startup and caches the address forever, so a recreated container
    # leaves the edge pointing at an address nobody answers on until the edge is
    # restarted too. The variable form defers resolution to the resolver declared
    # in nginx.conf and re-resolves on its TTL. $request_uri is appended because a
    # proxy_pass carrying variables does not forward the request URI on its own; it
    # is the RAW, still-encoded form, which is what the upstreams have always been
    # given and what the allow-list deliberately does NOT match on.
    set $upstream_host backend;
    proxy_pass https://$upstream_host:11261$request_uri;
  }
}
