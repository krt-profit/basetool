<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging for the ingest gateway. Mirrors the backend/frontend setup so ingest logs the same way:
  a PII-masked console + rolling text file + dedicated ERROR file in every profile, plus a structured
  JSON file in prod (logs/ingest.json) that Alloy ships to Loki via the same loki.source.file ->
  loki.process.app_json path as backend/frontend (epic #936, REQ-OBS-007). NEVER log tokens, names or
  emails (REQ-OBS-004): the application code only ever logs the draft kind and the correlation id, and
  the PiiMaskingPatternLayout / PiiMaskingLogstashEncoder scrub JWTs / e-mails / token keywords as a
  safety net. The ingest gateway carries only the correlationId MDC field (no userId / orgUnitId — it
  owns no per-user data).
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <property name="LOG_FILE" value="logs/ingest.log"/>
  <property name="LOG_ERROR_FILE" value="logs/ingest-error.log"/>

  <property name="LOG_PATTERN_CONSOLE" value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr([%X{correlationId:-}]){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>
  <property name="LOG_PATTERN_FILE" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%X{correlationId:-}] --- [%t] %-40.40logger{39} : %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
      <layout class="de.greluc.krt.profit.basetool.ingest.logging.PiiMaskingPatternLayout">
        <pattern>${LOG_PATTERN_CONSOLE}</pattern>
      </layout>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_FILE}</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>logs/ingest.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>50MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>2GB</totalSizeCap>
    </rollingPolicy>
    <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
      <layout class="de.greluc.krt.profit.basetool.ingest.logging.PiiMaskingPatternLayout">
        <pattern>${LOG_PATTERN_FILE}</pattern>
      </layout>
    </encoder>
  </appender>

  <!-- Dedicated ERROR-only appender so support can scan incidents without the full INFO stream. -->
  <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_ERROR_FILE}</file>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>ERROR</level>
    </filter>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>logs/ingest-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>20MB</maxFileSize>
      <maxHistory>60</maxHistory>
      <totalSizeCap>500MB</totalSizeCap>
    </rollingPolicy>
    <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
      <layout class="de.greluc.krt.profit.basetool.ingest.logging.PiiMaskingPatternLayout">
        <pattern>${LOG_PATTERN_FILE}</pattern>
      </layout>
    </encoder>
  </appender>

  <!--
    Async wrappers for the disk-backed appenders (same rationale as backend/frontend): the request
    thread hands the formatted event to a bounded queue instead of blocking on file I/O / masking, a
    single worker drains it, and discardingThreshold=0 keeps every event (audit-trail integrity over
    throughput). CONSOLE stays synchronous so the last lines before a JVM crash flush deterministically.
  -->
  <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>512</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <appender-ref ref="FILE"/>
  </appender>

  <appender name="ASYNC_ERROR_FILE" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>128</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <appender-ref ref="ERROR_FILE"/>
  </appender>

  <!--
    Structured JSON appender, prod only. Writes logs/ingest.json which Alloy tails via
    loki.source.file -> loki.process.app_json (the same path as backend/frontend), so the `level`
    field becomes a Loki label and ingest shows up on the "App errors & warnings" dashboard panel.
    PiiMaskingLogstashEncoder preserves the MDC (correlationId + trace fields) as first-class JSON.
  -->
  <springProfile name="prod">
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>logs/ingest.json</file>
      <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
        <fileNamePattern>logs/ingest.%d{yyyy-MM-dd}.%i.json.gz</fileNamePattern>
        <maxFileSize>50MB</maxFileSize>
        <maxHistory>30</maxHistory>
        <totalSizeCap>2GB</totalSizeCap>
      </rollingPolicy>
      <encoder class="de.greluc.krt.profit.basetool.ingest.logging.PiiMaskingLogstashEncoder">
        <includeMdcKeyName>correlationId</includeMdcKeyName>
        <!-- REQ-OBS-009 (epic #936 Phase 1b): trace correlation fields for the Grafana
             logs<->traces links. Meaningful only while tracing is
             enabled (MONITORING_TRACING_ENABLED=true); while disabled, at most dangling
             bridge-fallback ids appear (see REQ-OBS-009). Absent keys are simply omitted. The correlationId
             system above is untouched (REQ-OBS-001/-002). -->
        <includeMdcKeyName>traceId</includeMdcKeyName>
        <includeMdcKeyName>spanId</includeMdcKeyName>
        <customFields>{"app":"basetool-ingest"}</customFields>
      </encoder>
    </appender>

    <appender name="ASYNC_JSON_FILE" class="ch.qos.logback.classic.AsyncAppender">
      <queueSize>512</queueSize>
      <discardingThreshold>0</discardingThreshold>
      <appender-ref ref="JSON_FILE"/>
    </appender>
  </springProfile>

  <springProfile name="prod">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="ASYNC_FILE"/>
      <appender-ref ref="ASYNC_ERROR_FILE"/>
      <appender-ref ref="ASYNC_JSON_FILE"/>
    </root>
  </springProfile>
  <springProfile name="!prod">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="ASYNC_FILE"/>
      <appender-ref ref="ASYNC_ERROR_FILE"/>
    </root>
  </springProfile>

  <logger name="de.greluc.krt.profit.basetool" level="INFO"/>
  <logger name="org.springframework.web" level="INFO"/>
  <logger name="org.springframework.security" level="INFO"/>
</configuration>
