{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingest.profit-base.online/exchange/v1/schemas/location.schema.json",
  "title": "Location",
  "description": "A non-hidden warehouse location a client may offer.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "uex": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CITY",
            "SPACE_STATION"
          ]
        },
        "id": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "guid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "The DataForge GUID of the starmap object the location stands for, in lower-case canonical form: the location's own starmap object, else its city's, else its space station's. Absent when none is linked. Does not replace `uex`."
    }
  },
  "required": [
    "name"
  ]
}
