{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingest.profit-base.online/exchange/v1/schemas/page.schema.json",
  "title": "Page",
  "description": "A snapshot page or a change-feed page of one resource.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 1000
    },
    "removed": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "tombstone.schema.json"
      }
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "hasMore": {
      "type": "boolean"
    }
  },
  "required": [
    "items",
    "removed",
    "hasMore"
  ],
  "$defs": {
    "blueprintPage": {
      "allOf": [
        {
          "$ref": "#"
        }
      ],
      "properties": {
        "items": {
          "items": {
            "$ref": "blueprint.schema.json"
          }
        }
      }
    },
    "stockPage": {
      "allOf": [
        {
          "$ref": "#"
        }
      ],
      "properties": {
        "items": {
          "items": {
            "$ref": "stock-lot.schema.json"
          }
        }
      }
    },
    "shipPage": {
      "allOf": [
        {
          "$ref": "#"
        }
      ],
      "properties": {
        "items": {
          "items": {
            "$ref": "ship.schema.json"
          }
        }
      }
    },
    "refineryOrderPage": {
      "allOf": [
        {
          "$ref": "#"
        }
      ],
      "properties": {
        "items": {
          "items": {
            "$ref": "refinery-order.schema.json"
          }
        }
      }
    },
    "orgStockPage": {
      "allOf": [
        {
          "$ref": "#"
        }
      ],
      "properties": {
        "items": {
          "items": {
            "$ref": "org-stock-lot.schema.json"
          }
        },
        "units": {
          "type": "array",
          "maxItems": 1000,
          "description": "The units whose pools the member reads now. A unit no longer listed is gone for the client with all its lots.",
          "items": {
            "$ref": "org-unit.schema.json"
          }
        }
      },
      "required": [
        "units"
      ]
    },
    "bankAccountPage": {
      "allOf": [
        {
          "$ref": "#"
        }
      ],
      "description": "A snapshot page of the bank accounts the member views; removed is always empty, the bank has no change feed.",
      "properties": {
        "items": {
          "items": {
            "$ref": "bank-account.schema.json"
          }
        }
      }
    },
    "bankBookingPage": {
      "allOf": [
        {
          "$ref": "#"
        }
      ],
      "description": "A snapshot page of an account's bookings, newest first; removed is always empty, the bank has no change feed.",
      "properties": {
        "items": {
          "items": {
            "$ref": "bank-booking.schema.json"
          }
        }
      }
    },
    "bankRequestPage": {
      "allOf": [
        {
          "$ref": "#"
        }
      ],
      "description": "A snapshot page or a change-feed page of the member's own booking requests; removed names a request that no longer exists.",
      "properties": {
        "items": {
          "items": {
            "$ref": "bank-request.schema.json"
          }
        }
      }
    }
  }
}
