{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingest.profit-base.online/exchange/v1/schemas/job-order-material.schema.json",
  "title": "Material job order",
  "description": "A MATERIAL order of the member's set: the fields of every job order, the contact and the progress per material and quality floor.",
  "allOf": [
    {
      "$ref": "job-order.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "kind": {
      "const": "MATERIAL"
    },
    "contact": {
      "type": "string",
      "maxLength": 200,
      "description": "The author's contact handle as plain text; absent when the order names none."
    },
    "materials": {
      "type": "array",
      "maxItems": 1000,
      "description": "The progress per material and quality floor, in the material's own unit.",
      "items": {
        "type": "object",
        "properties": {
          "material": {
            "$ref": "item-ref.schema.json"
          },
          "minQuality": {
            "$ref": "quality.schema.json"
          },
          "unit": {
            "type": "string",
            "enum": [
              "SCU",
              "PIECE"
            ]
          },
          "requested": {
            "type": "number",
            "minimum": 0,
            "description": "The requested amount."
          },
          "handedOver": {
            "type": "number",
            "minimum": 0,
            "description": "The amount handed over to the requester."
          },
          "remaining": {
            "type": "number",
            "minimum": 0,
            "description": "The requested amount less the amount handed over, never below 0."
          },
          "open": {
            "type": "number",
            "minimum": 0,
            "description": "The remaining amount less the linked stock and the claims, never below 0."
          }
        },
        "required": [
          "material",
          "minQuality",
          "unit",
          "requested",
          "handedOver",
          "remaining",
          "open"
        ]
      }
    }
  },
  "required": [
    "kind",
    "materials"
  ]
}
