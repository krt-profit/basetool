{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingest.profit-base.online/exchange/v1/schemas/change-result.schema.json",
  "title": "Change result",
  "description": "The compact outcome of a change set (at most 32 KiB): counts, and per-op detail only for ops that were not applied.",
  "type": "object",
  "properties": {
    "dryRun": {
      "type": "boolean"
    },
    "applied": {
      "type": "integer",
      "minimum": 0
    },
    "unchanged": {
      "type": "integer",
      "minimum": 0
    },
    "notApplied": {
      "type": "integer",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "opId": {
            "type": "string",
            "maxLength": 64
          },
          "result": {
            "type": "string",
            "enum": [
              "unchanged",
              "unmatched",
              "ambiguous",
              "rejected"
            ]
          },
          "reason": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "The existing order a refinery-order create refused ALREADY_EXISTS names. Opaque identifier issued by the Basetool. Clients store and echo it, never parse it."
          }
        },
        "required": [
          "index",
          "result"
        ]
      }
    },
    "detachedFromMissions": {
      "type": "integer",
      "minimum": 0
    },
    "offersReduced": {
      "type": "integer",
      "minimum": 0
    },
    "offersRemoved": {
      "type": "integer",
      "minimum": 0
    },
    "orders": {
      "type": "array",
      "maxItems": 500,
      "description": "Refinery-order change sets only, not in a dry run: one entry per applied op.",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "opId": {
            "type": "string",
            "maxLength": 64
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "The order's id. Opaque identifier issued by the Basetool. Clients store and echo it, never parse it."
          },
          "goods": {
            "type": "array",
            "maxItems": 100,
            "description": "The ids of the goods rows the op created.",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "versions": {
            "type": "object",
            "description": "The order's section counters after the op.",
            "properties": {
              "gameData": {
                "type": "integer",
                "minimum": 0
              },
              "finances": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "gameData",
              "finances"
            ]
          }
        },
        "required": [
          "index",
          "id",
          "versions"
        ]
      }
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Reserved; not sent in v1. Read the feed after a push to learn the new position."
    },
    "warnings": {
      "$ref": "#/$defs/warnings"
    }
  },
  "required": [
    "dryRun",
    "applied",
    "unchanged",
    "notApplied",
    "results"
  ],
  "$defs": {
    "warnings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string",
            "maxLength": 200,
            "description": "JSON Pointer into the request."
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        },
        "required": [
          "pointer",
          "code"
        ]
      }
    }
  }
}
