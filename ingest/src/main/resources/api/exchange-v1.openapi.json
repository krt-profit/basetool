            }
          },
          "default": {
            "description": "An RFC 9457 problem with a `code` from the error registry.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "https://ingest.profit-base.online/exchange/v1/schemas/problem.schema.json"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/DPoP"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque feed position from a previous page. Without it the response is a snapshot. A cursor older than the tombstones answers 410 CURSOR_EXPIRED.",
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 500
            }
          }
        ]
      }
    },
