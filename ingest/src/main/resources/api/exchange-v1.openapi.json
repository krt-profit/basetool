  "components": {
    "securitySchemes": {
      "memberToken": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://profit-base.online/auth/realms/iri/.well-known/openid-configuration",
        "description": "The member's access token from the client's own public Keycloak client, device grant, sent as `Authorization: DPoP <token>` with a `DPoP` proof. Scopes are the capabilities; `exchange.connect` is the base scope."
      }
    },
    "parameters": {
      "DPoP": {
        "name": "DPoP",
        "in": "header",
        "required": true,
        "description": "The DPoP proof JWT for this request (RFC 9449). Required on every member route.",
        "schema": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "A fresh key per logical write, kept 24 h per client and member. A replay returns the first result.",
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  }
}
