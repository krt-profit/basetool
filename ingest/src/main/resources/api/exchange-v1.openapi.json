{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Profit Basetool exchange API",
    "version": "1.0",
    "summary": "Capability-scoped sync of a member's own data for approved external clients.",
    "description": "Approved clients only (docs/legal/approved-clients.md). Every member route requires a DPoP-bound access token of the member (RFC 9449) from the client's own public Keycloak client via the device grant (RFC 8628). Within v1 the contract only grows additively; readers must be tolerant (REQ-XCH-026).",
    "license": {
      "name": "GPL-3.0-only",
      "identifier": "GPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "https://ingest.profit-base.online",
      "description": "production"
    },
    {
      "url": "https://localhost:11262",
      "description": "local sandbox"
    }
  ],
  "paths": {
    "/exchange/v1": {
      "get": {
        "operationId": "service_document",
        "summary": "What this token may do and what the server expects.",
        "tags": [
          "service"
        ],
        "security": [
          {
            "memberToken": [
              "exchange.connect"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://ingest.profit-base.online/exchange/v1/schemas/service-document.schema.json"
                }
              }
            }
          },
          "default": {
            "description": "An RFC 9457 problem with a `code` from the error registry.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "https://ingest.profit-base.online/exchange/v1/schemas/problem.schema.json"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/DPoP"
          }
        ]
      }
    },
    "/exchange/v1/openapi.json": {
      "get": {
        "operationId": "contract_openapi",
        "summary": "This document.",
        "tags": [
          "contract"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "An RFC 9457 problem with a `code` from the error registry.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "https://ingest.profit-base.online/exchange/v1/schemas/problem.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/exchange/v1/schemas/{name}.schema.json": {
      "get": {
        "operationId": "contract_schema",
        "summary": "One published JSON Schema, served at its $id.",
        "tags": [
          "contract"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/schema+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "An RFC 9457 problem with a `code` from the error registry.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "https://ingest.profit-base.online/exchange/v1/schemas/problem.schema.json"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z-]+$"
            }
          }
        ]
      }
    },
