global:
  resolve_timeout: 5m
  smtp_smarthost: '${SMTP_SMARTHOST}'
  smtp_from: '${SMTP_FROM}'
  smtp_auth_username: '${SMTP_AUTH_USERNAME}'
  smtp_auth_password: '${SMTP_AUTH_PASSWORD}'
  smtp_require_tls: true

route:
  receiver: 'email'
  group_by: ['alertname']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 720h
  routes:
    - matchers:
        - alertname = "Watchdog"
      receiver: 'heartbeat'
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m
      continue: false
    - matchers:
        - severity = "critical"
      receiver: 'discord'
      group_wait: 0s
      repeat_interval: 1h
      continue: true
    - matchers:
        - alertname = "AlertmanagerNotificationsFailing"
      receiver: 'discord'
      repeat_interval: 1h
      continue: false
    - matchers:
        - severity = "critical"
      receiver: 'email'
      group_wait: 0s
      continue: false

receivers:
  - name: 'email'
    email_configs:
      - to: '${ALERT_EMAIL_TO}'
        send_resolved: true

  - name: 'heartbeat'
    webhook_configs:
      - url: '${HEARTBEAT_URL}'
        send_resolved: false

  - name: 'discord'
    discord_configs:
      - webhook_url: '${DISCORD_WEBHOOK_URL}'
        send_resolved: true

inhibit_rules:

  - source_matchers:
      - alertname = "TargetDown"
      - application =~ ".+"
    target_matchers:
      - severity = "warning"
      - application =~ ".+"
    equal: ['application']

  - source_matchers:
      - alertname = "BlackboxProbeFailed"
    target_matchers:
      - alertname =~ "CertificateExpiringSoon|Edge.*"
    equal: ['instance']

  - source_matchers:
      - alertname = "HostDiskCritical"
    target_matchers:
      - alertname = "HostDiskWarning"
    equal: ['mountpoint']

  - source_matchers:
      - alertname = "ContainerRestartLoop"
    target_matchers:
      - severity = "warning"
      - alertname =~ "ContainerMemoryHigh|ContainerOomKilled|ContainerCpuThrottledHigh|ContainerPidsHigh"
    equal: ['name']

  - source_matchers:
      - alertname = "TargetDown"
      - instance =~ ".+"
    target_matchers:
      - severity = "warning"
      - instance =~ ".+"
    equal: ['instance']
