# Alertmanager configuration TEMPLATE. Alertmanager 0.33.x (verified 2026-07). Epic #936, ADR-0072.
#
# Alertmanager does NOT expand environment variables, so this is a TEMPLATE: the rollout runbook
# renders it with `envsubst` to /var/iri/monitoring/secrets/alertmanager.yml and runs
# `amtool check-config` against the RENDERED file. The ${...} placeholders below come from the host
# .env (SMTP credentials + healthchecks.io ping URL). Alert e-mails never contain user data.
#
# SMTP: 587 STARTTLS, smtp_require_tls enforced. The Watchdog alert (always firing) is routed to the
# external heartbeat receiver — the dead-man's switch: if this stack or the host dies, the pings stop
# and healthchecks.io alerts.
global:
  resolve_timeout: 5m
  smtp_smarthost: '${SMTP_SMARTHOST}'
  smtp_from: '${SMTP_FROM}'
  smtp_auth_username: '${SMTP_AUTH_USERNAME}'
  smtp_auth_password: '${SMTP_AUTH_PASSWORD}'
  smtp_require_tls: true

route:
  receiver: 'email'
  # Group by alertname only. Grouping ALSO by `job` fanned TargetDown out into one e-mail per down
  # scrape job, so a single outage that dropped several targets sent several mails; the alert already
  # names the instance in its annotation, so `job` in the group key only splits notifications without
  # adding routing signal. Batching per alertname collapses a multi-target TargetDown (and the
  # per-container ContainerRestartLoop burst) into one mail.
  group_by: ['alertname']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # The always-firing Watchdog goes only to the external heartbeat, never to e-mail.
    - matchers:
        - alertname = "Watchdog"
      receiver: 'heartbeat'
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m
      continue: false
    # (#1041 item 9) Second channel: mirror every critical to Discord first, then fall through
    # (continue: true) to the critical e-mail route below, so an SMTP outage never silently loses a
    # critical alert.
    - matchers:
        - severity = "critical"
      receiver: 'discord'
      group_wait: 0s
      repeat_interval: 1h
      continue: true
    # AlertmanagerNotificationsFailing is itself e-mail-routed and thus circular when SMTP is the
    # failure — send it to Discord explicitly. It is a warning, so it never matches the critical route.
    - matchers:
        - alertname = "AlertmanagerNotificationsFailing"
      receiver: 'discord'
      continue: false
    # Critical alerts page e-mail immediately and repeat more often (reached via continue above).
    - matchers:
        - severity = "critical"
      receiver: 'email'
      group_wait: 0s
      repeat_interval: 1h
      continue: false

receivers:
  - name: 'email'
    email_configs:
      - to: '${ALERT_EMAIL_TO}'
        send_resolved: true

  # Dead-man's switch: forwards the Watchdog to healthchecks.io. When Alertmanager/Prometheus/the
  # host dies, these pings stop arriving and healthchecks.io fires its own external alert.
  - name: 'heartbeat'
    webhook_configs:
      - url: '${HEARTBEAT_URL}'
        send_resolved: false

  # (#1041 item 9) Second human channel: native Discord webhook. The URL is a host .env secret
  # (${DISCORD_WEBHOOK_URL}) rendered by envsubst at deploy time — never committed. If SMTP fails, a
  # critical alert (and AlertmanagerNotificationsFailing itself) still reaches Discord. Alert
  # annotations are PII-free (REQ-OBS-006/-007), so there is no privacy impact.
  - name: 'discord'
    discord_configs:
      - webhook_url: '${DISCORD_WEBHOOK_URL}'
        send_resolved: true

inhibit_rules:
  # (#1041 item 20) Root-cause suppression. The previous single rule required equal alertname AND job
  # across severities — which never occurs (a critical and a warning never share an alertname), so it
  # was a no-op: an app/exporter outage paged every derived warning separately, burying the cause.

  # 1. An app scrape target being down suppresses that app's derived warnings. Both sides require a
  #    non-empty application label (application=~".+") — otherwise Alertmanager's missing-label ==
  #    missing-label equality would make an exporter TargetDown (which has no application label) inhibit
  #    ALL application-less warnings.
  - source_matchers:
      - alertname = "TargetDown"
      - application =~ ".+"
    target_matchers:
      - severity = "warning"
      - application =~ ".+"
    equal: ['application']

  # 2. A failing liveness probe on an endpoint suppresses that endpoint's cert-expiry and edge-posture
  #    alerts (they carry no signal while the endpoint is down), matched on the shared instance label.
  - source_matchers:
      - alertname = "BlackboxProbeFailed"
    target_matchers:
      - alertname =~ "CertificateExpiringSoon|Edge.*"
    equal: ['instance']

  # 3. A critical disk-full alert suppresses the warning tier for the same mountpoint.
  - source_matchers:
      - alertname = "HostDiskCritical"
    target_matchers:
      - alertname = "HostDiskWarning"
    equal: ['mountpoint']

  # 4. A restart-looping container suppresses its OWN resource-pressure warnings — a container that is
  #    crash-looping trivially trips working-set / OOM / CPU-throttle / pids warnings as a SYMPTOM, and
  #    those carry no independent signal while ContainerRestartLoop (critical) already pages. Joined on
  #    `name` (present on every cAdvisor container series), so it only ever suppresses the SAME
  #    container's warnings, never an unrelated one. During the 2026-07-15 cascade this collapses the
  #    per-container ContainerWorkingSetHigh noise under the restart-loop page.
  - source_matchers:
      - alertname = "ContainerRestartLoop"
    target_matchers:
      - severity = "warning"
      - alertname =~ "ContainerWorkingSetHigh|ContainerOomKilled|ContainerCpuThrottledHigh|ContainerPidsHigh"
    equal: ['name']

  # 5. A down scrape target suppresses every warning derived from that same target's series — its
  #    metrics are stale while it is down, so any warning keyed to it is noise. Joined on `instance`;
  #    BOTH sides require instance=~".+" so a warning WITHOUT an instance label is never a target
  #    (Alertmanager treats missing==missing as equal, which would otherwise let one TargetDown inhibit
  #    every instance-less warning). This complements rule 1 (which joins on `application`, dropped by
  #    the app warnings that aggregate with `sum by (application)` but keep `instance`), e.g. it mutes
  #    KeycloakLoginErrorSpike (instance=keycloak:9000) when the keycloak scrape goes down.
  - source_matchers:
      - alertname = "TargetDown"
      - instance =~ ".+"
    target_matchers:
      - severity = "warning"
      - instance =~ ".+"
    equal: ['instance']
