{
  "schemaVersion": 39,
  "title": "Redis",
  "uid": "basetool-redis",
  "tags": [
    "basetool"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "redis",
        "label": "Instance",
        "description": "session is redis-session (Spring Session, reached by the frontend only); shared is redis-shared (the exchange, the ingest handoffs and the live-sync and notification channels).",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(redis_up, redis)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Redis Up",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "redis_up{redis=~\"$redis\"}",
          "legendFormat": "{{redis}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory Used vs Limit",
      "description": "Per instance: the memory Redis uses, its maxmemory (where noeviction starts refusing writes and RedisMemoryHigh reads its ratio) and the container's memory limit.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes{redis=~\"$redis\"}",
          "legendFormat": "used {{redis}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "label_replace(max by (name) (basetool:container:memory_limit_bytes{name=~\"redis-$redis\"}), \"redis\", \"$1\", \"name\", \"redis-(.+)\")",
          "legendFormat": "limit {{redis}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "redis_memory_max_bytes{redis=~\"$redis\"}",
          "legendFormat": "maxmemory {{redis}}",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Memory Used %",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * redis_memory_used_bytes{redis=~\"$redis\"} / on (redis) label_replace(max by (name) (basetool:container:memory_limit_bytes{name=~\"redis-$redis\"}), \"redis\", \"$1\", \"name\", \"redis-(.+)\")",
          "legendFormat": "{{redis}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "RDB Last Save Age",
      "description": "Seconds since the last completed RDB snapshot. Read it together with \"RDB Pending Changes\": `--save \"60 1\"` only snapshots when at least one key changed, so on a quiet night this age climbs past an hour with nothing wrong. Age alone is not a fault — age WITH pending changes is (RedisRdbStale).",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "time()-redis_rdb_last_save_timestamp_seconds{redis=~\"$redis\"}",
          "legendFormat": "{{redis}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Evicted Keys/s",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(redis_evicted_keys_total{redis=~\"$redis\"}[5m])",
          "legendFormat": "{{redis}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Connected Clients",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "redis_connected_clients{redis=~\"$redis\"}",
          "legendFormat": "{{redis}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Commands/s",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total{redis=~\"$redis\"}[5m])",
          "legendFormat": "{{redis}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "gauge",
      "title": "Keyspace Hit Ratio",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total{redis=~\"$redis\"}[5m])/(rate(redis_keyspace_hits_total{redis=~\"$redis\"}[5m])+rate(redis_keyspace_misses_total{redis=~\"$redis\"}[5m]))",
          "legendFormat": "{{redis}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "stat",
      "title": "RDB Pending Changes",
      "description": "Keys changed since the last completed RDB snapshot (INFO rdb_changes_since_last_save). Redis resets it only on a SUCCESSFUL save and restores it when a fork fails, so a steady non-zero value beside a growing \"RDB Last Save Age\" is the actual broken-snapshot signal. Zero means the store is idle and has nothing to save.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "redis_rdb_changes_since_last_save{redis=~\"$redis\"}",
          "legendFormat": "{{redis}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Persistence Status (1 = ok)",
      "description": "The two INFO status fields the persistence alerts read: rdb_last_bgsave_status (RedisRdbSaveFailing) and aof_last_write_status (RedisAofWriteFailing). The exporter maps ok to 1 and err to 0. AOF is the primary durability layer, RDB the fast-restart snapshot.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "redis_rdb_last_bgsave_status{redis=~\"$redis\"}",
          "legendFormat": "RDB bgsave {{redis}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "redis_aof_last_write_status{redis=~\"$redis\"}",
          "legendFormat": "AOF write {{redis}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
