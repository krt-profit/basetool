// Grafana Alloy config for the Basetool monitoring plane. Alloy 1.18.x (verified 2026-07).
// Epic #936, REQ-OBS-007 (per-stream log-privacy) / REQ-OBS-009 (OTLP trace collector), ADR-0072.
//
// Two responsibilities:
//   1. Receive app/Keycloak OTLP spans on the scrape net and forward them to Tempo on the core net
//      (apps never reach the trace store directly — the span push is funnelled through Alloy).
//   2. Ship logs to Loki with the per-stream masking rules. Container logs are read via the GET-only
//      docker-socket-proxy (tcp://socket-proxy:2375), never the raw docker socket.
//
// Per-stream privacy (REQ-OBS-007): app JSON is PII-masked AT SOURCE (no shipper masking) under
// app=backend/frontend/ingest; ADDITIONALLY the same three apps' raw container stdout/stderr is now
// shipped under the DISTINCT app=<svc>-stdout labels and masked HERE (ADR-0095) — this captures the
// JVM/glibc native errors (pthread_create failed / unable to create native thread, hs_err preamble)
// that bypass logback and so never reach the JSON file. The Keycloak file log is masked HERE
// (username= / ipAddress=); NPM access/error, host auth.log and the host security logs (auditd
// file-integrity, fail2ban bans) are ingested WITH client IPs/usernames (the deliberate, owner-approved
// 31-day retention). Stream labels stay low-cardinality: app (+ level for the JSON apps).

logging {
	level  = "info"
	format = "logfmt"
}

// =============================================================================================
// 1) OTLP trace collector: receive spans (scrape net) -> forward to Tempo (core net)
// =============================================================================================
otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	// This block's timeouts are INHERITED, and their defaults CHANGED in Alloy 1.18.0: idle_timeout,
	// read_header_timeout and write_timeout moved from "0s" (unlimited) to "1m" / "1m" / "30s" to match
	// the upstream OTel Collector. Deliberately NOT pinned back to "0s" — backend/frontend/ingest push
	// short batched POSTs to /v1/traces (MONITORING_OTLP_ENDPOINT), so a 30s write budget is ample, and
	// an unbounded read_header_timeout is a slowloris foothold even on this unpublished scrape-net port.
	// Keycloak uses the gRPC listener above and is unaffected. If trace gaps ever correlate with
	// exporter-side connection resets, suspect the 1m idle close racing a pooled client connection.
	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"

		tls {
			insecure = true
		}
	}
}

// =============================================================================================
// 2) Log shipping to Loki
// =============================================================================================
loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

// --- App JSON logs (already PII-masked at source; no shipper masking) -------------------------
local.file_match "backend" {
	path_targets = [{__path__ = "/logs/backend/backend.json", app = "backend"}]
}

loki.source.file "backend" {
	targets    = local.file_match.backend.targets
	forward_to = [loki.process.app_json.receiver]
}

local.file_match "frontend" {
	path_targets = [{__path__ = "/logs/frontend/frontend.json", app = "frontend"}]
}

loki.source.file "frontend" {
	targets    = local.file_match.frontend.targets
	forward_to = [loki.process.app_json.receiver]
}

local.file_match "ingest" {
	path_targets = [{__path__ = "/logs/ingest/ingest.json", app = "ingest"}]
}

loki.source.file "ingest" {
	targets    = local.file_match.ingest.targets
	forward_to = [loki.process.app_json.receiver]
}

loki.process "app_json" {
	forward_to = [loki.write.default.receiver]

	stage.json {
		expressions = {level = "level"}
	}

	stage.labels {
		values = {level = ""}
	}
}

// --- Keycloak file log: masked in the shipper (username= / ipAddress=) ------------------------
local.file_match "keycloak" {
	path_targets = [{__path__ = "/logs/keycloak/keycloak.log", app = "keycloak"}]
}

loki.source.file "keycloak" {
	targets    = local.file_match.keycloak.targets
	forward_to = [loki.process.keycloak_mask.receiver]
}

loki.process "keycloak_mask" {
	forward_to = [loki.write.default.receiver]

	stage.replace {
		expression = "(username=)(\\S+)"
		replace    = "${1}***"
	}

	stage.replace {
		expression = "(ipAddress=)(\\S+)"
		replace    = "${1}***"
	}
}

// --- NPM access + error logs (client IPs retained 31d — owner-approved, REQ-OBS-007/-010) -----
local.file_match "npm_access" {
	path_targets = [{__path__ = "/logs/npm/*_access.log", app = "npm-access"}]
}

loki.source.file "npm_access" {
	targets    = local.file_match.npm_access.targets
	forward_to = [loki.write.default.receiver]
}

local.file_match "npm_error" {
	path_targets = [{__path__ = "/logs/npm/*_error.log", app = "npm-error"}]
}

loki.source.file "npm_error" {
	targets    = local.file_match.npm_error.targets
	forward_to = [loki.write.default.receiver]
}

// --- Host auth log (SSH/sudo; usernames+IPs retained 31d). Journal variant: see the runbook. --
local.file_match "host_auth" {
	path_targets = [{__path__ = "/hostlog/auth.log", app = "host-auth"}]
}

loki.source.file "host_auth" {
	targets    = local.file_match.host_auth.targets
	forward_to = [loki.write.default.receiver]
}

// --- Host auditd log (sshd_config / authorized_keys tamper watches; carries the acting auid + paths,
// retained 31d). Under the /var/log:/hostlog mount this is /hostlog/audit/audit.log. PRECONDITION:
// audit.log must be readable by Alloy's supplementary `adm` group — set `log_group = adm` in
// /etc/audit/auditd.conf and make /var/log/audit traversable (0750 root:adm); the default root:root
// 0600 is unreadable and the stream would stay silently empty. ---
local.file_match "host_auditd" {
	path_targets = [{__path__ = "/hostlog/audit/audit.log", app = "host-auditd"}]
}

loki.source.file "host_auditd" {
	targets    = local.file_match.host_auditd.targets
	forward_to = [loki.write.default.receiver]
}

// --- Host fail2ban log (SSH-jail bans/unbans; carries banned client IPs, retained 31d). Debian/Ubuntu
// ship /var/log/fail2ban.log as 0640 root:adm, so Alloy's adm group reads it under /hostlog. ---
local.file_match "host_fail2ban" {
	path_targets = [{__path__ = "/hostlog/fail2ban.log", app = "host-fail2ban"}]
}

loki.source.file "host_fail2ban" {
	targets    = local.file_match.host_fail2ban.targets
	forward_to = [loki.write.default.receiver]
}

// --- Container logs via the GET-only docker-socket-proxy -------------------------------------
// Selected by the compose service label so it is independent of the project-prefixed container name.
discovery.docker "containers" {
	host = "tcp://socket-proxy:2375"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	// Keep only the container streams we ingest via the docker API (NPM stdout = operational logs
	// — nginx reloads, cert renewals, [emerg]/[error]; NOT admin-UI logins, which NPM never writes
	// to stdout; postgres runs with log_error_verbosity=terse).
	// (ADR-0095) backend/frontend/ingest ARE now kept — reversing the original REQ-OBS-007 decision to
	// ship these three via the masked JSON file ONLY. Their container stdout/stderr is shipped here IN
	// ADDITION to that file path, under the DISTINCT app=<svc>-stdout label (see the mapping rule below)
	// so it never muddies the JSON stream's {app="backend",level=...} queries, and masked in the shipper
	// (loki.process.container_mask). Motive: JVM/glibc native errors (pthread_create failed / unable to
	// create native thread) print to the container's stderr OUTSIDE logback, so they land in `docker
	// logs` but never in the masked JSON file — this stream is the only place Loki can see them.
	// (#1041 item 24) The monitoring plane's OWN stdout is shipped too: Grafana/Tempo have OOM-looped in
	// prod, and that evidence otherwise lived only in host docker-json logs (lost after 5x10MB rotation,
	// SSH-only). The regex is fully anchored, so `redis` never matches `redis-exporter` and the exact
	// `backend` alternative never matches `db-backend` / `postgres-exporter-backend`.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "backend|frontend|ingest|npm|redis|db-backend|db-keycloak|prometheus|grafana|loki|tempo|alloy|alertmanager|node-exporter|cadvisor|socket-proxy|postgres-exporter-backend|postgres-exporter-keycloak|redis-exporter|blackbox-exporter"
		action        = "keep"
	}
	// (#1041 item 24) Map every monitoring-plane service to a bounded `mon-<service>` app label.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "(prometheus|grafana|loki|tempo|alloy|alertmanager|node-exporter|cadvisor|socket-proxy|postgres-exporter-backend|postgres-exporter-keycloak|redis-exporter|blackbox-exporter)"
		target_label  = "app"
		replacement   = "mon-$1"
	}
	// Map the compose service to a stable, low-cardinality app label.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "db-backend"
		target_label  = "app"
		replacement   = "postgres-backend"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "db-keycloak"
		target_label  = "app"
		replacement   = "postgres-keycloak"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "(npm|redis)"
		target_label  = "app"
		replacement   = "$1"
	}
	// (ADR-0095) The three JVM apps' container stdout/stderr -> app=<svc>-stdout, kept DISTINCT from the
	// masked-JSON `app=backend|frontend|ingest` file streams so a mixed masked-JSON / raw-stdout label
	// never confuses the {app="backend",level="error"} JSON queries. Anchored, so `db-backend` is unaffected.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "(backend|frontend|ingest)"
		target_label  = "app"
		replacement   = "$1-stdout"
	}
}

loki.source.docker "containers" {
	host       = "tcp://socket-proxy:2375"
	targets    = discovery.relabel.containers.output
	forward_to = [loki.process.container_mask.receiver]
}

// (#1041 item 24 / ADR-0095) Shipper-side masking for the kept container streams that can carry PII
// (REQ-OBS-004/-007), mirroring the Keycloak file-log mask above. Every other kept stream (the edge /
// postgres operational logs) passes through untouched — the stage.match selectors gate the replaces to
// the grafana / alertmanager / <svc>-stdout apps only. The app JSON file streams stay masked at source.
loki.process "container_mask" {
	forward_to = [loki.write.default.receiver]

	// (2026-07-19) Drop stale re-delivered container lines BEFORE they reach loki.write. A near-idle
	// container (redis-exporter, the two postgres exporters and alertmanager log almost nothing after
	// startup) keeps its last stdout line at the tail; loki.source.docker re-opens the docker tail on
	// every reconnect ("could not transfer logs: unexpected EOF") and re-delivers that SAME last line.
	// While it is younger than Loki's reject_old_samples_max_age (168h, loki-config.yml) Loki silently
	// dedupes the repeat, but once it ages past that window every re-delivery is 400-rejected ("entry
	// has timestamp too old") and counted as a dropped entry -> loki_write_dropped_entries_total climbs
	// and LokiWriteFailing fires continuously (the 2026-07-18 redis-exporter incident: line frozen at
	// 2026-07-11T20:05:39Z, rejected from exactly +168h onward). Dropping entries older than the reject
	// window here — 167h, a 1h guard below Loki's 168h so Alloy always drops before Loki would reject —
	// ends the doomed pushes at the source for EVERY container stream generically. Week-old operational
	// stdout carries no signal and Loki would reject it regardless. The file streams (npm/host-auth, the
	// deliberate 31-day IP-retention paths) never pass through this processor and stamp their timestamp
	// at read time = now, so their long retention is untouched.
	stage.drop {
		older_than          = "167h"
		drop_counter_reason = "reject_old_samples_guard"
	}

	// Grafana logs its Keycloak-OIDC admin logins with `uname=` and the user's e-mail.
	stage.match {
		selector = "{app=\"mon-grafana\"}"

		stage.replace {
			expression = "(uname=)(\\S+)"
			replace    = "${1}***"
		}

		stage.replace {
			expression = "([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,})"
			replace    = "***"
		}
	}

	// Alertmanager SMTP-delivery-failure lines can carry the recipient e-mail.
	stage.match {
		selector = "{app=\"mon-alertmanager\"}"

		stage.replace {
			expression = "([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,})"
			replace    = "***"
		}
	}

	// (ADR-0095) The <svc>-stdout container streams are NOT masked at source (the logback console layout
	// masks the app's own lines, but the raw JVM/glibc stderr — native errors, the pre-logback banner, a
	// default-uncaught-handler stack trace — bypasses it). Mirror the source-side PiiMasker (JWT / e-mail
	// / bearer-token keyword) here as defense-in-depth so this reversal of the file-only decision cannot
	// leak a token or address the source masker would have caught. RE2 patterns (no possessive groups).
	stage.match {
		selector = "{app=~\"(backend|frontend|ingest)-stdout\"}"

		stage.replace {
			expression = "(eyJ[a-zA-Z0-9_-]{5,}\\.eyJ[a-zA-Z0-9_-]{5,}\\.[a-zA-Z0-9_-]{5,})"
			replace    = "JWT_***"
		}

		stage.replace {
			expression = "([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,})"
			replace    = "***"
		}

		stage.replace {
			expression = "(?i)(bearer\\s+|token\\s*[:=]?\\s*|session[-_]?id\\s*[:=]?\\s*|authorization\\s*[:=]?\\s*(?:bearer\\s+)?)([a-zA-Z0-9\\-_.+/=]+)"
			replace    = "${1}***"
		}
	}
}
