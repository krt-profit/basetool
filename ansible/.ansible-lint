---
# ansible-lint configuration for the Basetool host bootstrap (ADR-0188).
#
# WITHOUT THIS FILE ansible-lint lints the installed collections. CI runs
# `ansible-galaxy collection install -r requirements.yml -p ansible/collections`
# and then lints this directory, so the run reported **10507 failures across 2912
# files** — almost all of them upstream's, in code this repository neither wrote
# nor can change. A gate that fails on somebody else's style is a gate that gets
# ignored, and the handful of findings that are ours were invisible inside it.
#
# `ansible/collections/` is gitignored for the same reason build.gradle.kts
# excludes it from Spotless: it is fetched, not authored.
exclude_paths:
  - collections/
  # cloud-init/ is not Ansible. It is a cloud-config user-data file that happens to be YAML, and
  # ansible-lint's yamllint rules are the wrong checker for it: `#cloud-config` MUST be the first
  # line with no space after the `#`, which yaml[comments] reports as a defect, and the SSH public
  # keys it carries are single unbreakable tokens. It has a better validator, and CI runs it --
  # `cloud-init schema --config-file`, which reads the actual cloud-init schema rather than guessing
  # at style.
  - cloud-init/

# The playbook and the role are the subject. Everything else here is either
# generated, fetched, or a template rendered on the host.
