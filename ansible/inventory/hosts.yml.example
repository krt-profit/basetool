---
basetool_hosts:
  hosts:
    testing:
      ansible_host: 10.0.0.0          # the Rocky Linux 10 testing guest (ADR-0163)
      ansible_user: greluc
      basetool_host_ssh_lock_root: true
      basetool_host_retired_admin_users:
        - sysadm
      basetool_host_public_name_aliases:
        - "basetool.example.test:host-gateway"
        - "api.basetool.example.test:host-gateway"
        - "ingest.basetool.example.test:host-gateway"
        - "grafana.basetool.example.test:host-gateway"
      basetool_host_jvm_truststore_path: /etc/basetool/secrets/truststore.p12
    production:
      ansible_host: 203.0.113.0       # the new Hetzner CPX42
      ansible_user: greluc
      basetool_host_ssh_lock_root: true
      basetool_host_retired_admin_users:
        - sysadm
      basetool_host_public_name_aliases:
        - "basetool.example.com:host-gateway"
        - "api.basetool.example.com:host-gateway"
        - "ingest.basetool.example.com:host-gateway"
        - "grafana.basetool.example.com:host-gateway"
  vars:
    basetool_host_report_uid_map: true
    basetool_host_admin_user: greluc
    basetool_host_admin_authorized_keys:
      - "ssh-ed25519 AAAA... operator@workstation"
      - "ssh-ed25519 AAAA... basetool-ansible@controller"
